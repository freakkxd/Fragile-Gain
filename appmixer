        self.label.set_max_width_chars(22)
        texts.append(name_row)
        texts.append(self.sub)
        box.append(texts)

        # 3) слайдер — растягивается на всё свободное место (стиль HeroUI).
        # Шкала 0…MAX_VOLUME: «потолка» нет, громкость можно тянуть выше 100 %.
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, MAX_VOLUME, 1)
        self.scale.add_css_class("mixer")
        self.scale.set_draw_value(False)
        self.scale.set_hexpand(True)
        self.scale.set_valign(Gtk.Align.CENTER)
        self.scale.add_mark(100, Gtk.PositionType.BOTTOM, None)   # где «нормальные» 100%
        self.scale.connect("value-changed", self.on_scale)
        wheel = Gtk.EventControllerScroll.new(Gtk.EventControllerScrollFlags.VERTICAL)
        wheel.connect("scroll", self.on_wheel)
        self.scale.add_controller(wheel)
        box.append(self.scale)

        # 4) мьют — круглая кнопка-иконка
        self.mute_btn = Gtk.ToggleButton()
        self.mute_btn.add_css_class("mixer-mute")
        self.mute_btn.set_valign(Gtk.Align.CENTER)
        self.mute_btn.connect("toggled", self.on_mute)
        box.append(self.mute_btn)

        # 5) значение справа — бейдж-«пилюля»
        self.pct = Gtk.Label(xalign=0.5)
        self.pct.add_css_class("mixer-value")
        self.pct.set_valign(Gtk.Align.CENTER)
        box.append(self.pct)

        if child:
            outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            outer.append(self.trunk)
            box.set_hexpand(True)
            outer.append(box)
            self.set_child(outer)
        else:
            # заглушка ствола под плиткой приложения: соединяет её с источниками
            overlay = Gtk.Overlay()
            overlay.set_child(box)
            self.stub = Gtk.Box()
            self.stub.add_css_class("tree-stub")
            self.stub.set_halign(Gtk.Align.START)
            self.stub.set_valign(Gtk.Align.END)
            self.stub.set_margin_start(28)
            self.stub.set_visible(False)
            overlay.add_overlay(self.stub)
            self.set_child(overlay)
        self.update(app)

    def _set_class(self, name, on):
        if on:
            self.add_css_class(name)
        else:
            self.remove_css_class(name)

    def _set_tile(self, app):
        """Плитка приложения: настоящая иконка или буква на цветном фоне."""
        icon = app["icon"] or ""
        is_file = icon.startswith("/")
        has_icon = bool(icon) and (is_file or theme_icon_exists(icon))
        letter = next((c for c in app["label"] if c.isalnum()), "?").upper()
        key = ("icon", icon) if has_icon else ("letter", letter)
        if key == self.tile_key:
            return
        self.tile_key = key

        for i in range(TILE_COUNT):
            self.tile.remove_css_class("tile-%d" % i)
        self.tile.remove_css_class("has-icon")
        self.tile.set_tooltip_text(app["label"])

        if has_icon:
            box = 28 if not app.get("depth") else 20
            tex = normalized_icon(icon, box)
            try:
                if tex is not None:
                    self.tile_image.set_from_paintable(tex)
                elif is_file:
                    self.tile_image.set_from_file(icon)
                else:
                    self.tile_image.set_from_icon_name(icon)
                self.tile_image.set_pixel_size(box)
            except Exception:
                has_icon = False

        if not has_icon:
            color = zlib.crc32(app["key"].encode()) % TILE_COUNT
            self.tile.add_css_class("tile-%d" % color)
            self.tile_letter.set_text(letter)

        if has_icon:
            self.tile.add_css_class("has-icon")      # настоящая иконка — без подложки
        self.tile_image.set_visible(has_icon)
        self.tile_letter.set_visible(not has_icon)

    def update(self, app):
        self.app = app
        self.label.set_text(app["label"])
        self.sub.set_text(app["sub"])
        self.sub.get_parent().set_tooltip_text(app["sub"])
        self._set_tile(app)

        tip = tr("ключ аудиосервера: %s") % ", ".join(app["names"])
        if not app["live"]:
            tip += "\n" + tr("приложение сейчас молчит — громкость применится, когда зазвучит")
        self.dot.set_tooltip_text(tr("звучит сейчас"))
        self.scale.set_tooltip_text(tip)

        # играющие приложения подсвечиваются акцентом
        self._set_class("live", bool(app["live"]))
        self.dot.set_visible(bool(app["live"]))

        # доступное имя ползунка для скринридера
        acc = tr("Громкость: %s") % app["label"]
        if acc != self.acc_label:
            self.acc_label = acc
            try:
                self.scale.update_property([Gtk.AccessibleProperty.LABEL], [acc])
            except Exception:
                pass

        busy = (time.monotonic() - self.last_user_change) < 2.0
        self.suppress = True
        try:
            if not busy:
                self._ensure_range(app["volume"])
                self.scale.set_value(app["volume"])
                self.gesture = None
            vol = int(self.scale.get_value())
            self.shown_volume = vol
            self.pct.set_text("%d%%" % vol)
            muted = bool(app["mute"]) or vol == 0
            self.mute_btn.set_active(muted)
            self.mute_btn.set_icon_name(MUTE_ICON if muted else LIVE_ICON)
            self.mute_btn.set_tooltip_text(tr("Включить звук") if muted else tr("Заглушить"))
            try:
                self.mute_btn.update_property(
                    [Gtk.AccessibleProperty.LABEL],
                    [tr("Заглушить: %s") % app["label"] if not muted
                     else tr("Включить звук: %s") % app["label"]])
            except Exception:
                pass
            self._style_volume(vol, muted)
        finally:
            self.suppress = False

    def _style_volume(self, vol, muted):
        """Цвет по смыслу: красный — мьют, янтарный — громче 100 %, иначе акцент."""
        boost = vol > 100 and not muted
        for widget in (self, self.scale):
            for name, on in (("muted", muted), ("boost", boost)):
                if on:
                    widget.add_css_class(name)
                else:
                    widget.remove_css_class(name)

    def set_group(self, role, last_child=False):
        """Положение строки в карточке: solo / head (с источниками) / mid / tail."""
        for r in ("solo", "head", "mid", "tail"):
            self._set_class("g-" + r, r == role)
        if self.stub is not None:
            self.stub.set_visible(role == "head")
        if self.tree_bottom is not None:
            # у последнего источника линия вниз не нужна — под ним ничего нет
            if last_child:
                self.tree_bottom.add_css_class("last")
            else:
                self.tree_bottom.remove_css_class("last")

    def _ensure_range(self, vol):
        """Ползунок должен вмещать текущую громкость — даже если она выше 300 %."""
        adj = self.scale.get_adjustment()
        if vol > adj.get_upper():
            adj.set_upper(vol + 25)

    def on_wheel(self, controller, dx, dy):
        """Колесо мыши над ползунком — громкость (обычно VOLUME_STEP, с Ctrl — x10).

        Над остальной строкой колесо не перехватываем: там оно листает список.
        """
        if self.suppress or not dy:
            return False
        state = controller.get_current_event_state()
        step = 10 if state & Gdk.ModifierType.CONTROL_MASK else VOLUME_STEP
        tick = int(dy) if abs(dy) >= 1 else (1 if dy > 0 else -1)
        vol = max(0, int(self.scale.get_value()) - tick * step)
        self._ensure_range(vol)
        self.last_user_change = time.monotonic()
        self.scale.set_value(vol)
        return True

    def show_volume(self, vol):
        """Показать громкость на ползунке и в значении (без отправки в аудиосервер)."""
        self.suppress = True
        try:
            self._ensure_range(vol)
            self.scale.set_value(vol)
            self.pct.set_text("%d%%" % vol)
            muted = vol == 0 or bool(self.app.get("mute"))
            self.mute_btn.set_icon_name(MUTE_ICON if muted else LIVE_ICON)
            self._style_volume(vol, muted)
        finally:
            self.suppress = False
        self.shown_volume = vol
        self.last_user_change = time.monotonic()

    def on_scale(self, scale):
        if self.suppress:
            return
        now = time.monotonic()
        vol = int(scale.get_value())
        prev = self.shown_volume if self.shown_volume is not None else int(self.app.get("volume") or 0)
        kids = [self.window.rows.get(k["key"]) for k in (self.app.get("children") or [])]
        kids = [k for k in kids if k is not None]
        # Начало жеста — запоминаем исходные значения: вложенные сдвигаются на ту
        # же разницу ОТ НИХ, поэтому упор в 0 по дороге не копит ошибку.
        if self.gesture is None or now - self.last_user_change > 0.8:
            self.gesture = {"parent": prev,
                            "kids": {k.app["key"]: (k.shown_volume if k.shown_volume is not None
                                                     else int(k.app.get("volume") or 0)) for k in kids}}
        self.last_user_change = now
        self.shown_volume = vol
        self.pct.set_text("%d%%" % vol)
        muted = vol == 0
        self.mute_btn.set_icon_name(MUTE_ICON if muted else LIVE_ICON)
        self._style_volume(vol, muted)
        changes = [(self, vol)]
        delta = vol - self.gesture["parent"]
        for k in kids:
            base = self.gesture["kids"].get(k.app["key"], int(k.app.get("volume") or 0))
            upper = int(k.scale.get_adjustment().get_upper())
            kv = max(0, min(max(upper, base), base + delta))
            if kv != k.shown_volume:
                k.show_volume(kv)
                changes.append((k, kv))
        self.window.apply_volumes(changes)

    def on_mute(self, btn):
        if self.suppress:
            return
        self.last_user_change = time.monotonic()
        self.window.apply_mute(self, btn.get_active())


