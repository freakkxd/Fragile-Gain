def remember(row, pct):
    """Запомнить громкость строки и «паспорт» приложения в своём файле."""
    store = load_store()
    store["volumes"][row["key"]] = pct
    if row.get("ident"):
        store["ident"][row["key"]] = row["ident"]
    save_store(store)
    return store


def _apply_one(row, pct):
    """Громкость одной строке: её потокам — сразу, молчащей — беззвучным потоком."""
    own = row.get("streams") or []
    if own:
        for si in own:
            run(["pactl", "set-sink-input-volume", str(si["index"]), "%d%%" % pct])
    elif row.get("ident"):
        phantom(row["ident"], pct)
    remember(row, pct)


def set_volume(row, pct):
    """Громкость строки.

    У приложения с вложенными источниками (Anki → mpv) ползунок родителя
    двигает всех на ту же разницу: Anki −5 % → и у mpv −5 %. Ползунок
    вложенной строки двигает только её саму.
    """
    kids = row.get("children") or []
    delta = pct - int(row.get("volume") or 0)
    _apply_one(row, pct)
    if not delta:
        return
    for kid in kids:
        _apply_one(kid, max(0, int(kid.get("volume") or 0) + delta))


def set_mute(row, muted):
    targets = row.get("targets") or []
    if targets:
        for si in targets:
            run(["pactl", "set-sink-input-mute", str(si["index"]), "1" if muted else "0"])
        store = remember(row, row["volume"])
        for r in [row] + list(row.get("children") or []):
            if muted:
                store["muted"][r["key"]] = True
            else:
                store["muted"].pop(r["key"], None)
        save_store(store)
        return
    # WirePlumber не сохраняет флаг mute из свойств потока, поэтому «мьют»
    # молчащего приложения = запомненная громкость 0; прежнюю храним сами.
    store = load_store()
    key = row["key"]
    idents = row.get("phantoms") or ([row["ident"]] if row.get("ident") else [])
    if muted:
        prev = row["volume"] or 100
        if prev:
            store["prev"][key] = prev
        for ident in idents:
            phantom(ident, 0)
        store["volumes"][key] = 0
    else:
        back = store["prev"].pop(key, 100) or 100
        for ident in idents:
            phantom(ident, back)
        store["volumes"][key] = back
    if row.get("ident"):
        store["ident"][key] = row["ident"]
    save_store(store)


def _die_with_parent():
    """В дочернем процессе: получить SIGTERM, когда умрёт родитель (Linux prctl)."""
    try:
        import ctypes
        import signal as _signal
        ctypes.CDLL("libc.so.6", use_errno=True).prctl(1, _signal.SIGTERM)   # PR_SET_PDEATHSIG
    except Exception:
        pass


class VolumeGuard:
    """Держит запомненную громкость у НОВЫХ потоков.

    Когда приложение начинает играть заново, система создаёт ему новый поток со
    100 % — и звук на время «прыгает» на полную, пока громкость не поправят руками.
    Страж слушает события PipeWire (`pactl subscribe`) и сразу выставляет новому
    потоку громкость и мьют, которые вы задавали этой строке в микшере. Уже
    играющие потоки он не трогает (их вы двигаете сами).
    """

    FRESH = 2.5     # секунд после появления поток перепроверяем: приложение может
                    # выставить свою громкость уже после создания потока

    def __init__(self, on_fix=None):
        self.on_fix = on_fix
        self.seen = set()
        self.fresh = {}
        self.proc = None
        self.stream = None

    def start(self):
        for si in pactl_json("sink-inputs"):
            self.seen.add(si.get("index"))            # то, что играет сейчас, не трогаем
        try:
            # pactl умирает вместе с микшером при ЛЮБОМ завершении (kill, падение):
            # иначе осиротевшие `pactl subscribe` копятся и забивают лимит клиентов
            # pipewire-pulse — после этого ни один pactl не может подключиться.
            self.proc = subprocess.Popen(
                ["pactl", "subscribe"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL, preexec_fn=_die_with_parent)
        except Exception:
            self.proc = None
            return False
        self.stream = Gio.DataInputStream.new(
            Gio.UnixInputStream.new(self.proc.stdout.fileno(), False))
        self._read()
        return True

    def stop(self):
        if self.proc is not None:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=2)
            except Exception:
                try:
                    self.proc.kill()
                except Exception:
                    pass
            try:
                self.proc.stdout.close()
            except Exception:
                pass
            self.proc = None

    def _read(self):
        self.stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_line)

    def _on_line(self, stream, res):
        try:
            line, _length = stream.read_line_finish_utf8(res)
        except Exception:
            line = None
        if line is None:                              # pactl завершился — поднимаем заново
            if self.proc is not None:
                GLib.timeout_add_seconds(3, self._restart)
            return
        if "'new' on sink-input" in line:
            for delay in (0, 300, 1200):              # сразу и ещё пару раз: вдруг приложение переставит
                GLib.timeout_add(delay, self._check_once)
        self._read()

    def _restart(self):
        self.stop()
        self.proc = None
        self.start()
        return False

    def _check_once(self):
        self.apply(collect())
        return False

    def apply(self, rows):
        """Выставить запомненные громкость/мьют новым потокам строк. Возвращает, менял ли."""
        now = time.monotonic()
        store = load_store()
        volumes, muted = store["volumes"], store.get("muted", {})
        changed = False
        for row in rows:
            want = volumes.get(row["key"])
            want_mute = muted.get(row["key"])
            for si in row.get("streams") or []:
                idx = si.get("index")
                first = idx not in self.seen
                if not first and now >= self.fresh.get(idx, 0):
                    continue
                self.seen.add(idx)
                if first:
                    self.fresh[idx] = now + self.FRESH
                if want is not None and stream_volume(si) != want:
                    run(["pactl", "set-sink-input-volume", str(idx), "%d%%" % want])
                    changed = True
                if want_mute and not si.get("mute"):
                    run(["pactl", "set-sink-input-mute", str(idx), "1"])
                    changed = True
        if changed and self.on_fix:
            self.on_fix()
        return changed


