def builtin_themes():
    """Встроенные темы в порядке Notes: id, имя, кандзи, описание, схема."""
    try:
        data = json.loads((BASE_DIR / "fragile-themes.json").read_text(encoding="utf-8"))
        return [t for t in data.get("themes", []) if t.get("id") in gtk_fragile.TOKENS]
    except Exception:
        return [{"id": k, "name": k.title(), "kanji": "", "desc": {}, "scheme": v.get("scheme", "dark")}
                for k, v in gtk_fragile.TOKENS.items() if k not in ("dark", "light")]


def load_appearance():
    ui = load_ui()
    a = dict(APPEARANCE_DEFAULTS)
    if ui.get("theme") in ("dark", "light") and "color_scheme" not in ui:
        a["color_scheme"] = ui["theme"]                 # настройка старой версии
    for k in APPEARANCE_DEFAULTS:
        if k in ui:
            a[k] = ui[k]
    if a["color_scheme"] not in ("system", "dark", "light"):
        a["color_scheme"] = "system"
    if a["builtin_theme"] not in gtk_fragile.TOKENS or a["builtin_theme"] in ("dark", "light"):
        a["builtin_theme"] = ""
    if a["design"] not in DESIGNS:
        a["design"] = "sharp"
    if a["density"] not in DENSITIES:
        a["density"] = "regular"
    if not re.fullmatch(r"#[0-9a-fA-F]{6}", str(a["accent"] or "")):
        a["accent"] = ""
    return a


def save_appearance(a):
    ui = load_ui()
    ui.pop("theme", None)
    ui.update({k: a[k] for k in APPEARANCE_DEFAULTS})
    save_ui(ui)


def resolve_scheme(a):
    """Итоговая схема: у встроенной темы своя, иначе выбранная или системная."""
    if a["builtin_theme"]:
        return gtk_fragile.TOKENS[a["builtin_theme"]]["scheme"]
    if a["color_scheme"] in ("dark", "light"):
        return a["color_scheme"]
    try:
        return "dark" if Adw.StyleManager.get_default().get_dark() else "light"
    except Exception:
        return "dark"


def theme_tokens(a, scheme):
    return gtk_fragile.tokens(a["builtin_theme"], scheme, a["accent"])


def _token_rgb(t, name):
    """(r, g, b, a) токена: #rgb, #rrggbb, rgba(), а --color-accent-2 — по формуле Notes."""
    v = str(t[name]).strip()
    if name == "--color-accent-2" and v.startswith("hsl"):
        import colorsys
        r, g, b, _ = _token_rgb(t, "--interactive-accent")
        h, l, sat = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
        h = (h * 360 - 5) / 360 % 1                       # hsl(h-5, s*1.05, l*1.29)
        r, g, b = colorsys.hls_to_rgb(h, min(1.0, l * 1.29), min(1.0, sat * 1.05))
        return round(r * 255), round(g * 255), round(b * 255), 1.0
    m = re.fullmatch(r"#([0-9a-fA-F]{3})", v)
    if m:
        v = "#" + "".join(ch * 2 for ch in m.group(1))
    return gtk_fragile._rgb(v)


def _c(t, name, alpha=1.0):
    """Цвет токена (при нужде — с прозрачностью)."""
    r, g, b, a = _token_rgb(t, name)
    return "rgba(%d,%d,%d,%g)" % (r, g, b, a * alpha)


def build_css(a, scheme):
    """CSS компонентов микшера: цвета из токенов темы, форма из типа интерфейса."""
    t = theme_tokens(a, scheme)
    dark = scheme == "dark"
    design, density = a["design"], a["density"]
    glass_solid = design == "glass" and a["reduce_transparency"]

    BG, SIDE, ALT = _c(t, "--background-primary"), _c(t, "--background-secondary"), _c(t, "--background-primary-alt")
    TEXT, MUTED, FAINT = _c(t, "--text-normal"), _c(t, "--text-muted"), _c(t, "--text-faint")
    BORDER, BORDER_H = _c(t, "--background-modifier-border"), _c(t, "--background-modifier-border-hover")
    HOVER, ACTIVE = _c(t, "--background-modifier-hover"), _c(t, "--background-modifier-active")
    ACC, ON_ACC = _c(t, "--interactive-accent"), _c(t, "--text-on-accent")
    GREEN, ORANGE, RED = _c(t, "--color-green"), _c(t, "--color-orange"), _c(t, "--color-red")
    # текст состояний: кольцевые токены темнее на светлой схеме — контраст ≥ 4.5:1
    GREEN_T, ORANGE_T, RED_T = _c(t, "--ring-green"), _c(t, "--ring-amber"), _c(t, "--ring-red")
    if dark:
        GREEN_T, ORANGE_T, RED_T = GREEN, ORANGE, RED
    TRACK = _c(t, "--ring-track")
    TEXT_A = lambda x: _c(t, "--text-normal", x)       # noqa: E731
    ACC_A = lambda x: _c(t, "--interactive-accent", x)  # noqa: E731

    header_h = {"compact": 34, "regular": 40, "comfortable": 46}[density]
    btn_h = {"compact": 24, "regular": 28, "comfortable": 32}[density]
    row_pad = {"compact": 0, "regular": 3, "comfortable": 7}[density]
    gap = {"compact": 5, "regular": 8, "comfortable": 11}[density]

    # форма по типу интерфейса
    if design == "sharp":
        R_CARD, R_PILL, R_BTN, R_TILE, R_TILE_S, R_TRACK = 0, 0, 0, 0, 0, 0
    elif design == "classic":
        R_CARD, R_PILL, R_BTN, R_TILE, R_TILE_S, R_TRACK = 12, 6, 8, 8, 6, 999
    else:
        R_CARD, R_PILL, R_BTN, R_TILE, R_TILE_S, R_TRACK = 20, 999, 999, 10, 8, 999

    if design == "glass" and not glass_solid:
        CARD = _c(t, "--background-primary", 0.58)
        CARD_H = _c(t, "--background-primary", 0.70)
        CHILD = _c(t, "--background-primary", 0.42)
        MASTER = _c(t, "--background-primary", 0.78)
        POP = _c(t, "--background-primary", 0.90)
        RIM = "rgba(255,255,255,0.16)" if dark else "rgba(255,255,255,0.7)"
        RIM_TOP = "rgba(255,255,255,0.34)" if dark else "rgba(255,255,255,0.95)"
        SHADOW = "0 10px 30px -8px rgba(0,0,0,0.45), 0 2px 6px rgba(0,0,0,0.25)" if dark \
            else "0 10px 30px -8px rgba(20,30,60,0.22), 0 2px 6px rgba(20,30,60,0.10)"
        CARD_BORDER = f"1px solid {RIM}"
        CARD_SHADOW = f"inset 0 1px 0 {RIM_TOP}, {SHADOW}"
        WIN_BG = (f"radial-gradient(circle at 0% 0%, {ACC_A(0.34)}, transparent 55%), "
                  f"radial-gradient(circle at 100% 100%, {_c(t, '--color-accent-2', 0.26)}, transparent 55%), "
                  f"radial-gradient(circle at 100% 0%, {_c(t, '--text-accent', 0.14)}, transparent 45%)")
        LINE = TEXT_A(0.10)
    elif design == "glass":                     # уменьшить прозрачность: форма та же, без просвета
        CARD, CARD_H, CHILD, MASTER, POP = SIDE, HOVER, ALT, ALT, ALT
        CARD_BORDER, CARD_SHADOW, WIN_BG, LINE = f"1px solid {BORDER}", "none", "none", BORDER
    else:
        CARD, CARD_H, CHILD, MASTER, POP = ALT, HOVER, SIDE, SIDE, ALT
        CARD_BORDER = f"1px solid {BORDER}" if design == "sharp" else "1px solid transparent"
        CARD_SHADOW = "none" if design == "sharp" else \
            f"0 1px 2px rgba(0,0,0,{0.28 if dark else 0.03}), 0 4px 10px rgba(0,0,0,{0.18 if dark else 0.05})"
        WIN_BG, LINE = "none", BORDER

    WIN_SOLID = SIDE if glass_solid else BG
    POP_SHADOW = ("6px 6px 0 0 rgba(0,0,0,%s)" % (0.32 if dark else 0.1)) if design == "sharp" else \
        "0 8px 24px rgba(0,0,0,%s)" % (0.4 if dark else 0.15)
    LIVE_BAR = "2px" if design == "sharp" else "3px"
    mono = design == "sharp" and a["mono_labels"]
    MONO = "font-family: 'JetBrains Mono', ui-monospace, monospace;"
    LABEL = (MONO + " font-size: 10.5px; letter-spacing: 0.08em; font-weight: 600;") if mono else \
        "font-size: 11px; letter-spacing: 0.09em; font-weight: 800;"
    VALUE_FONT = MONO if mono else ""
    THUMB = 14 if design == "sharp" else 16
    tiles = "\n".join(
        ".tile-%d {{ background-color: %s; }}" % (i, (TEXT_A(0.14 + 0.04 * (i // 2)) if i % 2 == 0
                                                       else ACC_A(0.22 + 0.06 * (i // 2))))
        for i in range(TILE_COUNT)).replace("{{", "{").replace("}}", "}")

    return f"""
/* ── акцент libadwaita (переменные) — из темы Fragile, а не системный ──── */
:root {{ --accent-bg-color: {ACC}; --accent-fg-color: {ON_ACC}; --accent-color: {_c(t, "--text-accent")}; }}
switch:checked {{ background-color: {ACC}; }}
switch:checked > slider {{ {"background-color: " + ON_ACC + ";" if design == "sharp" else ""} }}
switch.theme-switch:checked {{ background-color: {TEXT_A(0.08)}; }}

/* ── окно: фон только у самого окна, подложки внутри прозрачные ─────────── */
window.mixer-win {{ background-color: {WIN_SOLID}; background-image: {WIN_BG}; color: {TEXT}; }}
window.mixer-win,
window.mixer-win.csd,
window.mixer-win.csd:backdrop {{
    border-radius: {WINDOW_RADIUS}px;            /* niri режет окно по своему радиусу */
    box-shadow: none;
    outline: none;
}}
window.mixer-win toolbarview, window.mixer-win scrolledwindow,
window.mixer-win viewport, list.mixer-list {{ background-color: transparent; }}
window.mixer-win headerbar {{
    min-height: {header_h}px;
    background-color: transparent;
    box-shadow: none;
    border-bottom: 1px solid {"transparent" if design == "glass" else LINE};
}}
window.mixer-win headerbar, window.mixer-win headerbar:backdrop {{ color: {TEXT}; }}
window.mixer-win headerbar > windowhandle > box,
window.mixer-win:backdrop headerbar > windowhandle > box,
window.mixer-win headerbar > *, window.mixer-win headerbar:backdrop > * {{ opacity: 1; }}
/* у окна не в фокусе libadwaita приглушает шапку (opacity/filter) — подписи должны читаться */
headerbar:backdrop, headerbar:backdrop > windowhandle, headerbar:backdrop > windowhandle > box,
headerbar:backdrop > windowhandle > box > *, headerbar:backdrop windowtitle,
headerbar:backdrop button, headerbar:backdrop switch, headerbar:backdrop image {{ filter: none; opacity: 1; }}
toolbarview > .top-bar:backdrop > windowhandle,
toolbarview > .top-bar headerbar:backdrop > windowhandle {{ filter: none; }}
window.mixer-win headerbar .title,
window.mixer-win headerbar:backdrop .title {{ font-weight: 700; color: {TEXT}; opacity: 1; }}
window.mixer-win headerbar .subtitle,
window.mixer-win headerbar:backdrop .subtitle {{ font-size: 11.5px; color: {MUTED}; opacity: 1; {VALUE_FONT} }}
window.mixer-win separator {{ background-color: {LINE}; }}

/* ── кнопки шапки: одна высота и одна форма ─────────────────────────────── */
window.mixer-win headerbar button,
window.mixer-win headerbar windowcontrols button {{
    min-height: {btn_h}px;
    min-width: {btn_h}px;
    padding: 0;
    margin: 0;
    border-radius: {R_BTN}px;
}}
window.mixer-win headerbar button.system-toggle,
window.mixer-win headerbar button.system-toggle:backdrop,
window.mixer-win headerbar button.appearance-button {{
    padding: 0 {12 if design != "glass" else 14}px;
    font-size: 12.5px;
    font-weight: 600;
    background-color: {TEXT_A(0.06) if design != "sharp" else "transparent"};
    box-shadow: inset 0 0 0 1px {BORDER_H};
    color: {TEXT};
    opacity: 1;
}}
window.mixer-win headerbar button.appearance-button {{ padding: 0; min-width: {btn_h}px; }}
window.mixer-win headerbar button.system-toggle:hover,
window.mixer-win headerbar button.appearance-button:hover {{ background-color: {HOVER}; }}
window.mixer-win headerbar button.system-toggle:checked {{
    background-color: {ACTIVE};
    box-shadow: {"inset 0 -2px 0 " + ACC + ", inset 0 0 0 1px " + BORDER_H if design == "sharp" else "inset 0 0 0 1px " + ACC_A(0.55)};
}}
window.mixer-win headerbar windowcontrols button {{ margin-left: 4px; color: {MUTED}; opacity: 1; }}
window.mixer-win headerbar windowcontrols button:hover {{ background-color: {HOVER}; color: {TEXT}; }}
button:focus-visible, switch:focus-visible {{ outline: 2px solid {ACC}; outline-offset: 1px; }}

/* ── переключатель тёмная/светлая (солнце / луна) ───────────────────────── */
switch.theme-switch {{
    min-width: {btn_h * 2 - 2}px;
    min-height: {btn_h}px;
    padding: 0;
    border: none;
