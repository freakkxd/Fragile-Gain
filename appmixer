def proc_ppid(pid):
    try:
        stat = Path("/proc/%s/stat" % pid).read_text()
        return int(stat[stat.rindex(")") + 2:].split()[1])
    except Exception:
        return 0


def proc_chain(pid, depth=32):
    """Цепочка родительских pid вверх (ближайшие первыми)."""
    chain, cur = [], pid
    for _ in range(depth):
        ppid = proc_ppid(cur)
        if ppid <= 1:
            break
        chain.append(ppid)
        cur = ppid
    return chain


def proc_hint(pid, binary):
    """Человекочитаемое имя для процессов вида python (Anki и подобные)."""
    if not pid:
        return ""
    if binary.startswith(("python", "pypy")):
        # 1) скрипт в аргументах командной строки
        try:
            parts = [p for p in Path("/proc/%s/cmdline" % pid).read_bytes().split(b"\0") if p]
            for p in parts[1:]:
                s = p.decode(errors="replace")
                if s.startswith("-"):
                    continue
                base = os.path.basename(s)
                if base.endswith((".py", ".pyw")):
                    return os.path.splitext(base)[0]
        except Exception:
            pass
        # 2) имя процесса-обёртки (например /usr/bin/anki)
        for anc in proc_chain(pid, depth=3):
            try:
                comm = Path("/proc/%d/comm" % anc).read_text().strip()
            except Exception:
                continue
            if comm and not comm.startswith(("python", "sh", "bash", "systemd")):
                return comm
    return ""


