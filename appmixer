LOCALES_DIR = BASE_DIR / "locales"
# код → название языка на нём самом (в меню языки подписаны своими именами)
LANGUAGES = [
    ("ru", "Русский"), ("en", "English"), ("de", "Deutsch"), ("fr", "Français"),
    ("es", "Español"), ("it", "Italiano"), ("pt", "Português"), ("pl", "Polski"),
    ("uk", "Українська"), ("tr", "Türkçe"), ("zh", "简体中文"), ("ja", "日本語"),
    ("ko", "한국어"),
]
_I18N = {"code": "ru", "table": {}}


def available_languages():
    """Языки, для которых есть файл перевода (русский — исходный, файла не нужно)."""
    return [(c, n) for c, n in LANGUAGES
            if c == "ru" or (LOCALES_DIR / ("%s.json" % c)).exists()]


def resolve_lang(pref):
    """Код языка интерфейса: выбранный пользователем либо язык системы."""
    codes = [c for c, _ in available_languages()]
    if pref and pref != "auto" and pref in codes:
        return pref
    for name in GLib.get_language_names():          # учитывает LANGUAGE, LC_ALL, LANG
        base = re.split(r"[_.@-]", name)[0].lower()
        if base in codes:
            return base
    return "en" if "en" in codes else "ru"


def set_language(code):
    table = {}
    if code != "ru":
        try:
            data = json.loads((LOCALES_DIR / ("%s.json" % code)).read_text(encoding="utf-8"))
            if isinstance(data, dict):
                table = {k: v for k, v in data.items() if isinstance(v, str) and v}
        except Exception:
            table = {}
    _I18N["code"], _I18N["table"] = code, table


def tr(text):
    """Строка интерфейса на выбранном языке (нет перевода — остаётся русская)."""
    return _I18N["table"].get(text, text)


