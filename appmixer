class MixerWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=APP_TITLE)
        self.add_css_class("mixer-win")
        _APPEARANCE_LISTENERS.append(lambda a, scheme: self.on_appearance_applied(a, scheme))
        self.set_default_size(880, -1)      # высоту подбирает GTK по содержимому
        self.rows = {}
        self.pending = {}
        self._inflight = {}           # поток -> следующее значение (pactl ещё работает)
        self._remember = {}           # ключ строки -> (app, громкость) для volumes.json
        self._rows_shown = None

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.title_widget = Adw.WindowTitle(
            title=APP_TITLE,
            subtitle=tr("громкость каждого приложения отдельно"))
        header.set_title_widget(self.title_widget)
        self.show_system = Gtk.ToggleButton(label=tr("служебные"))
        self.show_system.add_css_class("system-toggle")
        self.show_system.set_valign(Gtk.Align.CENTER)
        self.show_system.set_tooltip_text(
            tr("Показать служебные приложения (WirePlumber, порталы и т.п.).\n"
               "Они появятся ниже разделительной полосы."))
        self.show_system.set_active(bool(load_ui().get("show_system")))
        header.pack_start(self.show_system)
        header.pack_start(self._make_lang_button())
        header.pack_end(self._make_theme_switch())
        self.appearance_btn = Gtk.Button.new_from_icon_name(
            "preferences-desktop-appearance-symbolic"
            if theme_icon_exists("preferences-desktop-appearance-symbolic") else "applications-graphics-symbolic")
        self.appearance_btn.add_css_class("appearance-button")
        self.appearance_btn.set_valign(Gtk.Align.CENTER)
        self.appearance_btn.set_tooltip_text(tr("Оформление"))
        self.appearance_btn.update_property([Gtk.AccessibleProperty.LABEL], [tr("Оформление")])
        self.appearance_btn.connect("clicked", lambda *_: AppearanceWindow(self).present())
        header.pack_end(self.appearance_btn)
        toolbar.add_top_bar(header)
        self._header = header
        GLib.idle_add(self._center_header_buttons)

        self.user_list = self._make_list()
        self.system_list = self._make_list()

        # Раздел «служебные» показывается только по кнопке и отделяется
        # разделительной полосой, чтобы не искать всё в одной куче.
        self.system_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        sys_head = self._section(tr("Служебные"))
        self.sys_head = sys_head
        sys_head.set_margin_top(18)
        self.system_box.append(sys_head)
        self.system_box.append(self.system_list)
        self.system_box.set_visible(False)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.set_margin_top(10)
        content.set_margin_bottom(14)
        content.set_margin_start(12)
        content.set_margin_end(12)
        self.master = MasterRow()
        self.master.on_changed = self.refresh
        content.append(self.master)
        self.user_head = self._section(tr("Звук приложений"))
        content.append(self.user_head)
        content.append(self.user_list)
        content.append(self.system_box)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        # Высоту окна считает сам GTK по содержимому списка: окно ровно по
        # строкам (без пустого поля) и растёт/уменьшается вместе с ними. Если
        # список станет выше экрана, окно упрётся в край и список начнёт
        # прокручиваться колесом.
        scroller.set_propagate_natural_height(True)
        scroller.set_child(content)
        toolbar.set_content(scroller)
        self.set_content(toolbar)

        # Esc — закрыть окно (привычно для всплывающих панелей).
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        # A fix by the guard asks for ONE refresh soon. (refresh() returns True to keep its
        # timer going; handed to idle_add directly it would repeat forever — every fix used to add
        # another endless loop, up to dozens of refreshes and pactl calls per second.)
        self._refresh_idle = 0
        global LEVELS
        if LEVELS is None:
            LEVELS = LevelMonitor()
        self.guard = VolumeGuard(on_fix=self._refresh_soon)
        self.guard.start()
        self.connect("close-request", self._on_close)
        self._refresh_timer = GLib.timeout_add(REFRESH_MS, self.refresh)
        self.connect("map", lambda *_: self.refresh())     # shown (again): fill at once
        self.show_system.connect("toggled", self.on_system_toggled)
        self.refresh()

    def _make_theme_switch(self):
        """Переключатель тёмная ⇄ светлая: бегунок с солнцем и луной."""
        overlay = Gtk.Overlay()
        self.theme_switch = Gtk.Switch()
        self.theme_switch.add_css_class("theme-switch")
        self.theme_switch.set_valign(Gtk.Align.CENTER)
        self._switch_sync = False
        self.theme_switch.set_active(resolve_scheme(load_appearance()) == "dark")
        self.theme_switch.set_tooltip_text(tr("Тема: тёмная / светлая"))
        try:
            self.theme_switch.update_property([Gtk.AccessibleProperty.LABEL],
                                              [tr("Тёмная тема")])
        except Exception:
            pass
        overlay.set_child(self.theme_switch)
        self.sun = Gtk.Image.new_from_icon_name("weather-clear-symbolic")
        self.moon = Gtk.Image.new_from_icon_name("weather-clear-night-symbolic")
        for icon, align in ((self.sun, Gtk.Align.START), (self.moon, Gtk.Align.END)):
            icon.set_pixel_size(14)
            icon.add_css_class("theme-icon")
            icon.set_halign(align)
            icon.set_valign(Gtk.Align.CENTER)
            icon.set_margin_start(7)
            icon.set_margin_end(7)
            icon.set_can_target(False)
            overlay.add_overlay(icon)
        self.theme_switch.connect("notify::active", self.on_theme_toggled)
        self._theme_icons()
        return overlay

    def _make_lang_button(self):
