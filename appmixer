def cli_list():
    apps = collect()
    print("%-24s %-6s %-34s %-6s %s" % ("ПРИЛОЖЕНИЕ", "ГРОМК", "ПОДПИСЬ", "ПОТОК", "ПАСПОРТ"))
    for a in apps:
        name = ("   └ " if a["depth"] else "") + a["label"]
        state = a["sub"]
        ident = " ".join("%s=%s" % (k.split(".")[-1], v) for k, v in a["ident"].items())
        print("%-24s %-6s %-34s %-6d %s" % (
            name[:24], "%d%%" % a["volume"], state[:34], len(a["streams"]), ident[:30],
        ))


def find_app(pattern):
    """Приложение по подписи или ключу (без учёта регистра, по подстроке)."""
    pat = pattern.lower()
    apps = collect()
    for a in apps:
        if a["label"].lower() == pat or a["key"].lower() == pat:
            return a
    for a in apps:
        if pat in a["key"].lower():
            return a
    for a in apps:
        if pat in a["label"].lower():
            return a
    return None


def cli_action(argv):
    """appmixer --set Steam 30 / --mute Steam / --unmute Steam"""
    def value(flag):
        if flag in argv:
            i = argv.index(flag)
            return argv[i + 1] if i + 1 < len(argv) else None
        return None

    name = value("--set") or value("--mute") or value("--unmute")
    if not name:
        return None
    app = find_app(name)
    if not app:
        print("не нашёл приложение: %s" % name, file=sys.stderr)
        return 1

    if "--set" in argv:
        i = argv.index("--set")
        try:
            pct = int(argv[i + 2])
        except (IndexError, ValueError):
            print("нужно: --set <приложение> <проценты>", file=sys.stderr)
            return 2
        set_volume(app, pct)
        print("%s -> %d%%" % (app["label"], pct))
    elif "--mute" in argv:
        set_mute(app, True)
        print("%s заглушено" % app["label"])
    else:
        set_mute(app, False)
        print("%s включено" % app["label"])
    return 0


def main():
    if "--phantom" in sys.argv:
        # внутренний режим: беззвучный поток + громкость ему (зовётся самим микшером)
        i = sys.argv.index("--phantom")
        try:
            pct = int(sys.argv[i + 1])
        except (IndexError, ValueError):
            return 2
        return phantom_worker(pct, sys.argv[i + 2:])
    if "--list" in sys.argv:
        cli_list()
        return 0
    if "--outputs" in sys.argv:
        for o in list_outputs():
            print("%s %-8s %s" % ("*" if o["default"] else " ",
                                  "hidden" if o["hidden"] else ("dead" if o["dead"] else ""), o["label"]))
        return 0
    if "--next-output" in sys.argv or "--prev-output" in sys.argv:
        set_language(resolve_lang(load_ui().get("lang")))
        t = next_output(1 if "--next-output" in sys.argv else -1)
        print(t["label"] if t else "no other outputs")
        return 0 if t else 1
    if "--daemon" in sys.argv:
        return run_daemon()
    if {"--set", "--mute", "--unmute"} & set(sys.argv):
        code = cli_action(sys.argv)
        if code is not None:
            return code

    set_language(resolve_lang(load_ui().get("lang")))
    GLib.set_application_name(APP_TITLE)
    Gtk.Window.set_default_icon_name(APP_ID)    # иконка из ~/.local/share/icons/hicolor
    GLib.set_prgname(APP_ID)
    app = Adw.Application(application_id=APP_ID)

    def on_activate(a):
        install_css()
        win = a.get_active_window()
        if win is None:
            win = MixerWindow(a)
            apply_appearance(win)                # класс design-<тип> на окне
        win.present()

    app.connect("activate", on_activate)
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
