            return False
        return bool(Gtk.IconTheme.get_for_display(display).has_icon(name))
    except Exception:
        return False


CSS_PROVIDER = None
_APPEARANCE_LISTENERS = []


def apply_appearance(window=None):
    """Применить «Оформление»: схема libadwaita, общий слой Fragile и CSS микшера."""
    global CSS_PROVIDER
    display = Gdk.Display.get_default()
    if display is None:
        return None
    a = load_appearance()
    sm = Adw.StyleManager.get_default()
    if a["builtin_theme"] or a["color_scheme"] != "system":
        want = gtk_fragile.TOKENS[a["builtin_theme"]]["scheme"] if a["builtin_theme"] else a["color_scheme"]
        sm.set_color_scheme(Adw.ColorScheme.FORCE_LIGHT if want == "light" else Adw.ColorScheme.FORCE_DARK)
    else:
        sm.set_color_scheme(Adw.ColorScheme.DEFAULT)       # «как в системе»
    scheme = resolve_scheme(a)
    gtk_fragile.apply(window, theme=a["builtin_theme"], scheme=scheme, design=a["design"],
                      density=a["density"], mono_labels=a["mono_labels"],
                      reduce_transparency=a["reduce_transparency"], accent=a["accent"])
    if CSS_PROVIDER is None:
        CSS_PROVIDER = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            display, CSS_PROVIDER, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 2)
    CSS_PROVIDER.load_from_string(build_css(a, scheme))
    for cb in list(_APPEARANCE_LISTENERS):
        cb(a, scheme)
    return a


