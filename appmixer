def _rgba(t, name, alpha=1.0):
    r, g, b, a = _token_rgb(t, name)
    return r / 255, g / 255, b / 255, a * alpha


def _rounded(cr, x, y, w, h, r):
    r = min(r, w / 2, h / 2)
    if r <= 0:
        cr.rectangle(x, y, w, h)
        return
    import math
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def draw_preview(cr, w, h, t, design):
    """Мини-окно: фон, боковая панель, строки и акцент — в форме типа интерфейса."""
    rad = {"sharp": 0, "classic": 5, "glass": 9}[design]
    cr.set_source_rgba(*_rgba(t, "--background-primary"))
    _rounded(cr, 0, 0, w, h, 0 if design == "sharp" else 6)
    cr.fill()
    if design == "glass":
        import cairo
        g = cairo.RadialGradient(0, 0, 0, 0, 0, w * 0.9)
        g.add_color_stop_rgba(0, *_rgba(t, "--interactive-accent", 0.45))
        g.add_color_stop_rgba(1, *_rgba(t, "--interactive-accent", 0.0))
        cr.set_source(g)
        cr.rectangle(0, 0, w, h)
        cr.fill()
    pad = 5 if design == "glass" else 0
    side_w = w * 0.30
    cr.set_source_rgba(*_rgba(t, "--background-secondary", 0.62 if design == "glass" else 1))
    _rounded(cr, pad, pad, side_w - pad, h - 2 * pad, rad)
    cr.fill()
    for i in range(3):                                           # строки-«карточки»
        y = h * 0.16 + i * h * 0.27
        x0 = side_w + 6
        cr.set_source_rgba(*_rgba(t, "--background-primary-alt", 0.7 if design == "glass" else 1))
        _rounded(cr, x0, y, w - x0 - 6, h * 0.2, rad)
        cr.fill()
        if design == "sharp" or design == "classic":
            cr.set_source_rgba(*_rgba(t, "--background-modifier-border"))
            cr.set_line_width(1)
            _rounded(cr, x0 + 0.5, y + 0.5, w - x0 - 7, h * 0.2 - 1, rad)
            cr.stroke()
        bar_y = y + h * 0.1
        cr.set_source_rgba(*_rgba(t, "--interactive-accent"))   # «слайдер»
        _rounded(cr, x0 + 6, bar_y - 1.5, (w - x0 - 18) * (0.35 + 0.2 * i), 3, 0 if design == "sharp" else 1.5)
        cr.fill()
    # выделение в боковой панели: полоска / заливка / капля
    sy = h * 0.2
    if design == "sharp":
        cr.set_source_rgba(*_rgba(t, "--background-modifier-active"))
        cr.rectangle(pad, sy, side_w - pad, h * 0.14)
        cr.fill()
        cr.set_source_rgba(*_rgba(t, "--interactive-accent"))
        cr.rectangle(pad, sy, 2, h * 0.14)
        cr.fill()
    else:
        cr.set_source_rgba(*_rgba(t, "--interactive-accent", 0.35 if design == "glass" else 0.28))
        _rounded(cr, pad + 3, sy, side_w - pad - 6, h * 0.14, rad)
        cr.fill()


class AppearanceWindow(Adw.Window):
    """Оформление: тип дизайна, плотность, прозрачность, моно-подписи, тема и акцент."""

    def __init__(self, parent):
        super().__init__(transient_for=parent, modal=True, title=tr("Оформление"),
                         application=parent.get_application())
        self.add_css_class("appearance-win")
        self.set_default_size(720, 760)
        self.parent_win = parent
        self.busy = False
        self.a = load_appearance()

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title=tr("Оформление"), subtitle=APP_TITLE))
        toolbar.add_top_bar(header)
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        for setter in ("set_margin_top", "set_margin_bottom", "set_margin_start", "set_margin_end"):
            getattr(body, setter)(14)
        scroller.set_child(body)
        toolbar.set_content(scroller)
        self.set_content(toolbar)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda c, kv, kc, st: (self.close(), True)[1] if kv == Gdk.KEY_Escape else False)
        self.add_controller(keys)

        # ── Вид ─────────────────────────────────────────────────────────────
        body.append(self._label(tr("Вид")))
        g = self._group()
        body.append(g)
        g.append(self._row_title(tr("Тип дизайна"),
                                 tr("Компоновка и форма интерфейса. Цветовая тема и акцент работают с любым типом.")))
        types = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, homogeneous=True)
        self.design_btns = {}
        group = None
        for d, name, desc in (("sharp", tr("Чёткий"), tr("Основной: прямые углы, ясные границы блоков, плотная сетка")),
                              ("classic", tr("Классический"), tr("Мягкие скругления и плавающие панели, как раньше")),
                              ("glass", tr("Стекло"), tr("Как в новой iOS: полупрозрачные панели"))):
            btn = self._card(lambda area, cr, w, h, d=d: draw_preview(cr, w, h, self._tokens(), d),
                             name, "", desc, 150, 80)
            group = self._radio(btn, group)
            btn.connect("toggled", self._on_design, d)
            self.design_btns[d] = btn
            types.append(btn)
        g.append(types)

        g.append(self._sep())
        dens_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        dens_row.append(self._row_title(tr("Плотность"), tr("Высота строк, вкладок и заголовков панелей."), expand=True))
        seg = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        seg.set_valign(Gtk.Align.CENTER)
        self.density_btns, group = {}, None
        for d, name in (("compact", tr("Компактная")), ("regular", tr("Обычная")), ("comfortable", tr("Просторная"))):
            b = Gtk.ToggleButton(label=name)
            b.add_css_class("segment")
            group = self._radio(b, group)
            b.connect("toggled", self._on_density, d)
            self.density_btns[d] = b
            seg.append(b)
        dens_row.append(seg)
        g.append(dens_row)

        self.transp_sep = self._sep()
        g.append(self.transp_sep)
        self.transp_row, self.transp_sw = self._switch_row(
            tr("Уменьшить прозрачность"),
            tr("Панели станут непрозрачными: проще читать и легче для слабых компьютеров."),
            "reduce_transparency")
        g.append(self.transp_row)
        self.mono_sep = self._sep()
        g.append(self.mono_sep)
        self.mono_row, self.mono_sw = self._switch_row(
            tr("Моноширинные подписи"),
            tr("Заголовки разделов, сводка и значения — моноширинным шрифтом заглавными."),
            "mono_labels")
        g.append(self.mono_row)

        # ── Цвета ───────────────────────────────────────────────────────────
        body.append(self._label(tr("Цвета")))
        g = self._group()
        body.append(g)
        g.append(self._row_title(tr("Встроенная тема оформления"), ""))
        self.theme_desc = Gtk.Label(xalign=0, wrap=True)
        self.theme_desc.add_css_class("appearance-desc")
        g.append(self.theme_desc)
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                           max_children_per_line=4, min_children_per_line=2,
                           row_spacing=8, column_spacing=8)
        self.theme_btns, group = {}, None
        std = (("std:dark", tr("Тёмная"), "dark"), ("std:light", tr("Светлая"), "light"),
               ("std:system", tr("Системная"), None))
        for key, name, sch in std:
            btn = self._card(lambda area, cr, w, h, sch=sch: self._draw_theme(cr, w, h, "", sch),
                             name, "", tr("Стандартная тема"), 140, 64)
            group = self._radio(btn, group)
            btn.connect("toggled", self._on_theme, key)
            self.theme_btns[key] = btn
            flow.append(btn)
        lang = "ru" if _I18N["code"] in ("ru", "uk") else "en"
        self.theme_info = {}
        for th in builtin_themes():
            desc = (th.get("desc") or {}).get(lang) or (th.get("desc") or {}).get("en", "")
            self.theme_info[th["id"]] = (th.get("name", th["id"]), th.get("kanji", ""), desc)
            btn = self._card(lambda area, cr, w, h, tid=th["id"]: self._draw_theme(cr, w, h, tid, None),
                             th.get("name", th["id"]), th.get("kanji", ""), desc, 140, 64)
            group = self._radio(btn, group)
            btn.connect("toggled", self._on_theme, th["id"])
            self.theme_btns[th["id"]] = btn
            flow.append(btn)
        g.append(flow)
        self.scheme_hint = Gtk.Label(label=tr("Задаётся выбранной темой. Смена схемы вернёт стандартную тему."),
                                     xalign=0, wrap=True)
        self.scheme_hint.add_css_class("appearance-desc")
        g.append(self.scheme_hint)

        g.append(self._sep())
        acc_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        acc_row.append(self._row_title(tr("Цвет акцента"), tr("Цвет ссылок, кнопок и выделений."), expand=True))
        self.accent_btn = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(with_alpha=False))
        self.accent_btn.set_valign(Gtk.Align.CENTER)
        self.accent_btn.connect("notify::rgba", self._on_accent)
        acc_row.append(self.accent_btn)
        self.accent_reset = Gtk.Button(label=tr("Сбросить"))
        self.accent_reset.add_css_class("accent-reset")
        self.accent_reset.set_valign(Gtk.Align.CENTER)
        self.accent_reset.connect("clicked", self._on_accent_reset)
        acc_row.append(self.accent_reset)
        g.append(acc_row)

        self.areas = []
        self._sync()
        _APPEARANCE_LISTENERS.append(self._on_applied)
        self.connect("close-request", lambda *_: (_APPEARANCE_LISTENERS.remove(self._on_applied)
                                                  if self._on_applied in _APPEARANCE_LISTENERS else None, False)[1])

    # ── строительные блоки ──────────────────────────────────────────────────
    def _label(self, text):
        lbl = Gtk.Label(label=text.upper(), xalign=0)
        lbl.add_css_class("mixer-section")
        lbl.set_margin_start(4)
        lbl.set_margin_top(4)
        return lbl

    def _group(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.add_css_class("appearance-group")
        return box

    def _sep(self):
        return Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)

    def _row_title(self, title, desc, expand=False):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.set_hexpand(expand)
        t = Gtk.Label(label=title, xalign=0)
        t.add_css_class("appearance-title")
        box.append(t)
        if desc:
            d = Gtk.Label(label=desc, xalign=0, wrap=True)
            d.add_css_class("appearance-desc")
            box.append(d)
        return box

    def _switch_row(self, title, desc, key):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.append(self._row_title(title, desc, expand=True))
        sw = Gtk.Switch(valign=Gtk.Align.CENTER)
        sw.update_property([Gtk.AccessibleProperty.LABEL], [title])
        sw.connect("notify::active", lambda s, _p: self._set(key, s.get_active()))
        row.append(sw)
        return row, sw

    def _radio(self, btn, group):
        if group is not None:
            btn.set_group(group)
        return group or btn

    def _card(self, draw, name, kanji, desc, w, h):
        btn = Gtk.ToggleButton()
        btn.add_css_class("appearance-card")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        area = Gtk.DrawingArea(content_width=w, content_height=h)
        area.set_draw_func(draw)
        area.set_hexpand(True)
        box.append(area)
        self.areas = getattr(self, "areas", [])
        self.areas.append(area)
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        n = Gtk.Label(label=name, xalign=0)
        n.add_css_class("appearance-card-name")
        head.append(n)
        if kanji:
            k = Gtk.Label(label=kanji, xalign=0)
            k.add_css_class("appearance-card-kanji")
            head.append(k)
        box.append(head)
        if desc:
            d = Gtk.Label(label=desc, xalign=0, wrap=True, lines=2, ellipsize=3)
            d.set_max_width_chars(22)
            d.add_css_class("appearance-card-desc")
            box.append(d)
        btn.set_child(box)
        btn.set_tooltip_text(desc or name)
        btn.update_property([Gtk.AccessibleProperty.LABEL], [("%s %s" % (name, kanji)).strip()])
        return btn

    def _tokens(self):
        return theme_tokens(self.a, resolve_scheme(self.a))

    def _draw_theme(self, cr, w, h, tid, scheme):
        if tid:
            t = gtk_fragile.tokens(tid, gtk_fragile.TOKENS[tid]["scheme"], self.a["accent"])
        elif scheme:
            t = gtk_fragile.tokens("", scheme, self.a["accent"])
        else:                                   # «системная»: половина тёмной, половина светлой
            draw_preview(cr, w, h, gtk_fragile.tokens("", "dark", self.a["accent"]), self.a["design"])
            cr.save()
            cr.move_to(w * 0.62, 0)
            cr.line_to(w, 0)
            cr.line_to(w, h)
            cr.line_to(w * 0.38, h)
            cr.close_path()
            cr.clip()
            draw_preview(cr, w, h, gtk_fragile.tokens("", "light", self.a["accent"]), self.a["design"])
            cr.restore()
            return
        draw_preview(cr, w, h, t, self.a["design"])

    # ── состояние ───────────────────────────────────────────────────────────
    def _sync(self):
        self.busy = True
        try:
            a = self.a
            self.design_btns[a["design"]].set_active(True)
            self.density_btns[a["density"]].set_active(True)
            self.transp_sw.set_active(bool(a["reduce_transparency"]))
            self.mono_sw.set_active(bool(a["mono_labels"]))
            glass, sharp = a["design"] == "glass", a["design"] == "sharp"
            for w in (self.transp_sep, self.transp_row):
                w.set_visible(glass)
            for w in (self.mono_sep, self.mono_row):
                w.set_visible(sharp)
            key = a["builtin_theme"] or "std:%s" % a["color_scheme"]
            self.theme_btns.get(key, self.theme_btns["std:system"]).set_active(True)
            if a["builtin_theme"]:
                name, kanji, desc = self.theme_info.get(a["builtin_theme"], (a["builtin_theme"], "", ""))
                self.theme_desc.set_text("%s %s — %s" % (name, kanji, desc) if desc else name)
            else:
                self.theme_desc.set_text(tr("Стандартная тема"))
            self.scheme_hint.set_visible(bool(a["builtin_theme"]))
            rgba = Gdk.RGBA()
            rgba.parse(a["accent"] or self._tokens()["--interactive-accent"])
            self.accent_btn.set_rgba(rgba)
            self.accent_reset.set_visible(bool(a["accent"]))
        finally:
            self.busy = False
        for area in self.areas:
            area.queue_draw()

    def _set(self, key, value):
        if self.busy:
            return
        self.a[key] = value
        save_appearance(self.a)
        apply_appearance(self.parent_win)

    def _on_applied(self, a, scheme):
        self.a = dict(a)
        self._sync()

    def _on_design(self, btn, d):
        if btn.get_active():
            self._set("design", d)

    def _on_density(self, btn, d):
        if btn.get_active():
            self._set("density", d)

    def _on_theme(self, btn, key):
        if not btn.get_active() or self.busy:
            return
        if key.startswith("std:"):
            self.a["builtin_theme"] = ""
            self.a["color_scheme"] = key[4:]
        else:
            self.a["builtin_theme"] = key
        save_appearance(self.a)
        apply_appearance(self.parent_win)

    def _on_accent(self, btn, _param):
        if self.busy:
            return
        c = btn.get_rgba()
        self._set("accent", "#%02x%02x%02x" % (round(c.red * 255), round(c.green * 255), round(c.blue * 255)))

    def _on_accent_reset(self, _btn):
        self._set("accent", "")


