#  Фантомный поток — задать громкость молчащему приложению
# ─────────────────────────────────────────────────────────────────────────────

def ensure_silence():
    try:
        if SILENCE.exists() and SILENCE.stat().st_size > 1000:
            return True
    except OSError:
        pass
    try:
        import wave
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        frames = int(48000 * PHANTOM_MS / 1000)
        with wave.open(str(SILENCE), "wb") as w:
            w.setnchannels(2)
            w.setsampwidth(2)
            w.setframerate(48000)
            w.writeframes(b"\x00\x00\x00\x00" * frames)
        return True
    except Exception:
        return False


def phantom(ident, pct):
    """Задать громкость молчащему приложению.

    В аудиосервере у молчащего приложения нет потока, поэтому создаём свой
    беззвучный поток с тем же «паспортом» — WirePlumber запоминает громкость под
    ним и применит её, когда приложение зазвучит. Работает в отдельном процессе:
    создать поток, дождаться его появления и выставить громкость через pactl —
    ровно так же, как для звучащего приложения.
    """
    if not ensure_silence():
        return
    args = [sys.executable, os.path.abspath(__file__), "--phantom", str(max(0, pct))]
    for key, val in ident.items():
        if val:
            args.append("%s=%s" % (key, val))
    key = json.dumps(ident, sort_keys=True)
    old = _PHANTOMS.pop(key, None)
    if old is not None and old.poll() is None:
        try:                                  # иначе более старый поток мог закончить позже
            os.killpg(old.pid, 15)            # и WirePlumber запомнил бы устаревшую громкость
        except Exception:
            pass
    try:
        _PHANTOMS[key] = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                          start_new_session=True)
    except Exception:
        pass


_PHANTOMS = {}


def phantom_worker(pct, items):
    """Процесс-помощник: беззвучный поток + громкость живому потоку."""
    ident = {}
    for item in items:
        key, _, val = item.partition("=")
        if key in IDENT_KEYS and val:
            ident[key] = val
    if not ident:
        return 1
    props = "{ " + " ".join(
        "%s=%s" % (k, json.dumps(v, ensure_ascii=False)) for k, v in ident.items()
    ) + " " + PHANTOM_MARK + "=true }"
    try:
        proc = subprocess.Popen(
            ["pw-cat", "--playback", "-P", props, str(SILENCE)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        return 1
    for _ in range(40):
        time.sleep(0.03)
        for si in pactl_json("sink-inputs"):
            p = si.get("properties") or {}
            if str(p.get(PHANTOM_MARK)) not in ("true", "True", "1"):
                continue
            if all(str(p.get(k)) == v for k, v in ident.items()):
                run(["pactl", "set-sink-input-volume", str(si["index"]), "%d%%" % max(0, pct)])
                return 0
        if proc.poll() is not None:
            break
    return 1


