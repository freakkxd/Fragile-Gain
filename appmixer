    # ── обновление ──────────────────────────────────────────────────────────

    def _refresh_soon(self):
        if not self._refresh_idle:
            def once():
                self._refresh_idle = 0
                self.refresh()
                return False
            self._refresh_idle = GLib.idle_add(once)

    def _on_close(self, *_):
        """Closing ends everything: the guard, the refresh timer, a pending refresh — and the app."""
        # отложенное (фантомы молчащих, запись volumes.json) выполняем сразу, а не теряем
        for name, src in list(self.pending.items()):
            GLib.source_remove(src)
        self.pending.clear()
        for row in self.rows.values():
            app = row.app
            if app["key"] in self._remember and not app.get("streams") and app.get("ident"):
                phantom(app["ident"], self._remember[app["key"]][1])
        self._flush_remember()
        self.guard.stop()
        if LEVELS is not None:
            LEVELS.stop_all()
        for attr in ("_refresh_timer", "_refresh_idle"):
            src = getattr(self, attr, 0)
            if src:
                GLib.source_remove(src)
                setattr(self, attr, 0)
        app = self.get_application()
        if app is not None:
            GLib.idle_add(lambda: (app.quit(), False)[1])
        return False

    def refresh(self):
        if not self._refresh_timer:
            return False                        # closed: the timer must not outlive the window
        if not self.get_mapped():
            return True                         # hidden: nothing to draw, nothing to ask pactl
        self.master.update(master_info())
        apps = collect()
        self.guard.apply(apps)                  # подстраховка к событиям: новые потоки — на запомненную громкость
        if not self.show_system.get_active():
            apps = [a for a in apps if not a["system"]]

        user = [a for a in apps if not a["system"]]
        system = [a for a in apps if a["system"]]

        self._fill(self.user_list, user)
        self._fill(self.system_list, system)
        self.system_box.set_visible(bool(system))

        # подпись в шапке: сколько приложений и сколько из них сейчас звучит
        if not apps:
            sub = tr("нет источников звука")
        else:
            roots = [a for a in apps if not a["depth"]]
            kids = len(apps) - len(roots)
            sub = tr("приложений: %d") % len(roots)
            if kids:
                sub += tr(" · источников: %d") % kids
            sub += tr(" · звучит: %d") % sum(1 for a in roots if a["live"])
        self.title_widget.set_subtitle(sub)
        # Строк стало больше/меньше (или включили раздел «служебные») — подгоняем
        # высоту окна ровно под содержимое, чтобы внизу не оставалось пустого поля.
        shown = sum(1 for r in self.rows.values() if r.get_parent() is not None)
        if shown != self._rows_shown:
            self._rows_shown = shown
            GLib.idle_add(self._fit_height)
        return True

    def _fit_height(self):
        """Высота окна = натуральная высота содержимого (шапка + строки).

        Если строк больше, чем помещается на экране, окно не вылезает за
        край: оно ограничивается высотой монитора, а список внутри начинает
        прокручиваться колесом.
        """
        _, natural, _, _ = self.get_content().measure(
            Gtk.Orientation.VERTICAL, max(1, self.get_width() or 880))
        limit = 0
        try:
            display = Gdk.Display.get_default()
            monitors = list(display.get_monitors()) if display else []
            if monitors:
                # берём меньшую сторону всех мониторов: окно (niri открывает его
                # у курсора) не должно уезжать за край ни на одном из экранов
                side = min(min(mon.get_geometry().width, mon.get_geometry().height)
                           for mon in monitors)
                limit = int(side * 0.8)
        except Exception:
            limit = 0
        if limit and natural > limit:
            natural = limit
        if natural > 0:
            self.set_default_size(self.get_width() or 880, natural)
        return False

    def _fill(self, listbox, apps):
        """Приводит содержимое одного списка в соответствие с apps (по порядку)."""
        want = {a["key"]: a for a in apps}

        # убрать исчезнувшие
        for key in list(self.rows):
            row = self.rows[key]
            if row.get_parent() is listbox and key not in want:
                listbox.remove(row)
                del self.rows[key]

        # добавить новые / обновить существующие
        for key, a in want.items():
            row = self.rows.get(key)
            if row is None:
                row = AppRow(self, a)
                self.rows[key] = row
                listbox.append(row)
            else:
                parent = row.get_parent()
                if parent is not listbox:
                    if parent is not None:
                        parent.remove(row)
                    listbox.append(row)
                row.update(a)

        # положение строки в карточке: приложение + его источники — одна группа
        for i, a in enumerate(apps):
            row = self.rows.get(a["key"])
            if row is None:
                continue
            nxt = apps[i + 1] if i + 1 < len(apps) else None
            next_child = bool(nxt and nxt["depth"] and nxt["parent_key"] == (a["key"] if not a["depth"] else a["parent_key"]))
            if a["depth"]:
                row.set_group("mid" if next_child else "tail", last_child=not next_child)
            else:
                row.set_group("head" if next_child else "solo")

        # порядок строк
        for i, a in enumerate(apps):
            row = self.rows.get(a["key"])
            if row is not None and row.get_index() != i:
                listbox.remove(row)
                listbox.insert(row, i)

    # ── отложенное применение ползунка ───────────────────────────────────────

    def apply_volumes(self, changes):
        """Громкость строкам — сразу.

        Звучащим строкам: `pactl set-sink-input-volume` на каждый их поток, без
        ожидания и без пересбора списка; если по потоку команда ещё идёт, отправится
        только последнее значение. Молчащим: беззвучный поток-«фантом» — он тяжёлый,
        поэтому один, после того как ползунок остановился. Запись в volumes.json — так же.
        """
        for row, vol in changes:
            app = row.app
            for si in app.get("streams") or []:
                self._send_stream_volume(si["index"], vol)
            if not app.get("streams") and app.get("ident"):
                self._later("phantom:" + app["key"], APPLY_DELAY_MS,
                            lambda app=app, vol=vol: phantom(app["ident"], vol))
            self._remember[app["key"]] = (app, vol)
        self._later("remember", 150, self._flush_remember)

    def _send_stream_volume(self, idx, vol):
        if idx in self._inflight:
            self._inflight[idx] = vol                 # отправим, когда закончится текущая
            return
        self._inflight[idx] = None
        try:
            proc = Gio.Subprocess.new(["pactl", "set-sink-input-volume", str(idx), "%d%%" % vol],
                                      Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
        except Exception:
            self._inflight.pop(idx, None)
            return

        def done(p, res):
            try:
                p.wait_finish(res)
            except Exception:
                pass
            nxt = self._inflight.pop(idx, None)
            if nxt is not None:
                self._send_stream_volume(idx, nxt)
        proc.wait_async(None, done)

    def _later(self, name, ms, fn):
        """Отложить действие; повторный вызов с тем же именем переносит его."""
        old = self.pending.pop(name, None)
        if old:
            GLib.source_remove(old)

        def fire():
            self.pending.pop(name, None)
            fn()
            return False
        self.pending[name] = GLib.timeout_add(ms, fire)

    def _flush_remember(self):
        items, self._remember = self._remember, {}
        if not items:
            return
        store = load_store()
        for key, (app, vol) in items.items():
            store["volumes"][key] = vol
            if app.get("ident"):
                store["ident"][key] = app["ident"]
        save_store(store)

    def apply_mute(self, row, muted):
        key = row.app["key"]
        fresh = next((a for a in collect() if a["key"] == key), None) or row.app
        set_mute(fresh, muted)
        self.refresh()


