    def _center_header_buttons(self):
        """Крестик окна тянется на всю высоту шапки (овал) — центрируем, как остальные."""
        def walk(w):
            c = w.get_first_child()
            while c is not None:
                yield c
                yield from walk(c)
                c = c.get_next_sibling()
        for w in walk(self._header):
            if w.get_css_name() == "button":
                w.set_valign(Gtk.Align.CENTER)
        return False

    def _theme_icons(self):
