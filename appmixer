def load_outputs_cfg():
    cfg = {"hidden": [], "hotkey": DEFAULT_HOTKEY}
    try:
        data = json.loads(OUTPUTS_FILE.read_text())
        if isinstance(data, dict):
            if isinstance(data.get("hidden"), list):
                cfg["hidden"] = [str(x) for x in data["hidden"]]
            if "hotkey" in data:
                cfg["hotkey"] = str(data["hotkey"] or "")
    except Exception:
        pass
    return cfg


def save_outputs_cfg(cfg):
    try:
        CONF_DIR.mkdir(parents=True, exist_ok=True)
        OUTPUTS_FILE.write_text(json.dumps(cfg, ensure_ascii=False, indent=2))
    except OSError:
        pass


def list_outputs():
    """Все аудиовыходы: имя, подпись, «мёртвый» ли (ни одного подключённого порта),
    выход по умолчанию, скрыт ли пользователем."""
    r = run(["pactl", "get-default-sink"])
    default = r.stdout.strip() if r and r.returncode == 0 else ""
    hidden = set(load_outputs_cfg()["hidden"])
    outs = []
    for sk in pactl_json("sinks"):
        ports = sk.get("ports") or []
        dead = bool(ports) and all(p.get("availability") == "not available" for p in ports)
        outs.append({
            "name": sk.get("name", ""),
            "label": sk.get("description") or sk.get("name", ""),
            "dead": dead,
            "default": sk.get("name") == default,
            "hidden": sk.get("name") in hidden,
        })
    return outs


def set_hidden(name, hide):
    cfg = load_outputs_cfg()
    hid = [h for h in cfg["hidden"] if h != name]
    if hide:
        hid.append(name)
    cfg["hidden"] = hid
    save_outputs_cfg(cfg)


def hide_dead_outputs():
    cfg = load_outputs_cfg()
    for o in list_outputs():
        if o["dead"] and o["name"] not in cfg["hidden"] and not o["default"]:
            cfg["hidden"].append(o["name"])
    save_outputs_cfg(cfg)


def desktop_notify(body, title=None):
    """Уведомление, если в системе есть notify-send (иначе тихо пропускаем)."""
    exe = shutil.which("notify-send")
    if exe:
        run([exe, "-a", APP_TITLE, "-i", "audio-card", title or tr("Аудиовыход"), body], timeout=5)


def switch_output(name):
    """Сделать выход основным и перенести на него уже играющие потоки."""
    run(["pactl", "set-default-sink", name])
    r = run(["pactl", "list", "short", "sink-inputs"])
    for line in (r.stdout.splitlines() if r and r.returncode == 0 else []):
        idx = line.split("\t")[0]
        if idx.isdigit():
            run(["pactl", "move-sink-input", idx, name])


def next_output(step=1, notify=True):
    """Переключить на следующий (step=-1 — на предыдущий) доступный нескрытый выход."""
    cands = [o for o in list_outputs() if not o["hidden"] and not o["dead"]]
    cur = next((i for i, o in enumerate(cands) if o["default"]), -1)
    others = [o for o in cands if not o["default"]]
    if not others:
        if notify:
            desktop_notify(tr("Нет других доступных выходов"))
        return None
    target = cands[(cur + step) % len(cands)] if cur >= 0 else cands[0]
    switch_output(target["name"])
    if notify:
        desktop_notify(target["label"])
    return target


# Сочетание хранится в формате GTK («<Control>XF86AudioMute»); для портала и
# для niri его нужно перевести в их написание.
def accel_parts(accel):
    ok, keyval, mods = Gtk.accelerator_parse(accel or "")
    if not ok or not keyval:
        return None
    name = Gdk.keyval_name(keyval)
    if 0x1008FF00 <= keyval <= 0x1008FFFF and not name.startswith("XF86"):
        name = "XF86" + name               # мультимедийные клавиши: в xkb они называются XF86…
    return name, mods


def accel_to_portal(accel):
    parts = accel_parts(accel)
    if not parts:
        return ""
    key, mods = parts
    names = []
    for flag, nm in ((Gdk.ModifierType.CONTROL_MASK, "CTRL"), (Gdk.ModifierType.SHIFT_MASK, "SHIFT"),
                     (Gdk.ModifierType.ALT_MASK, "ALT"), (Gdk.ModifierType.SUPER_MASK, "LOGO")):
        if mods & flag:
            names.append(nm)
    return "+".join(names + [key])


def self_command():
    return '"%s" --next-output' % (BASE_DIR / "appmixer")


def run_daemon():
    """Фоновый режим без окна.

    1. Страж громкости: новым потокам (приложение начало играть заново) сразу
       выставляется запомненная в микшере громкость — без этого они стартуют со
       100 %. Работает везде, где есть PipeWire/PulseAudio.
    2. Глобальный хоткей смены выхода через xdg-desktop-portal GlobalShortcuts —
       там, где компоновщик это поддерживает (KDE Plasma, GNOME 48+). В niri, sway
       и Hyprland портал отказывает: страж всё равно работает, а хоткей нужно
       привязать командой --next-output в конфиге компоновщика.
    """
    loop = GLib.MainLoop()
    guard = VolumeGuard()
    if not guard.start():
        print("не удалось запустить слежение за потоками (нет pactl?)", file=sys.stderr)
        return 3
    print("страж громкости запущен: новые потоки получат запомненную громкость")

    accel = load_outputs_cfg()["hotkey"]
    trigger = accel_to_portal(accel)
    if trigger:
        try:
            _bind_global_hotkey(trigger)
        except Exception as exc:
            print("глобальный хоткей недоступен: %s (привяжите команду %s в конфиге компоновщика)"
                  % (exc, self_command()), file=sys.stderr)
    loop.run()
    return 0


def _bind_global_hotkey(trigger):
    """Регистрация хоткея в портале. Ошибки не фатальны для фонового режима."""
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    sender = bus.get_unique_name()[1:].replace(".", "_")
    state = {"sess": None}
    PORTAL = ("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop")

    def request(token, cb):
        path = "/org/freedesktop/portal/desktop/request/%s/%s" % (sender, token)
        bus.signal_subscribe(PORTAL[0], "org.freedesktop.portal.Request", "Response", path, None,
                             Gio.DBusSignalFlags.NONE, cb, None)

    def on_bound(conn, sname, path, iface, sig, params, _):
        code, _res = params.unpack()
        if code != 0:
            print("портал не поддерживает глобальные сочетания в этом окружении "
                  "(привяжите команду %s в конфиге компоновщика)" % self_command(), file=sys.stderr)
            return
        print("глобальный хоткей %s зарегистрирован" % trigger)

    def on_session(conn, sname, path, iface, sig, params, _):
        code, res = params.unpack()
        if code != 0:
            print("не удалось создать сессию GlobalShortcuts", file=sys.stderr)
            return
        state["sess"] = res["session_handle"]
        request("fgbind", on_bound)
        shortcuts = [("next-output", {
            "description": GLib.Variant("s", "Next audio output"),
            "preferred_trigger": GLib.Variant("s", trigger)})]
        bus.call_sync(PORTAL[0], PORTAL[1], "org.freedesktop.portal.GlobalShortcuts", "BindShortcuts",
                      GLib.Variant("(oa(sa{sv})sa{sv})",
                                   (state["sess"], shortcuts, "", {"handle_token": GLib.Variant("s", "fgbind")})),
                      GLib.VariantType("(o)"), Gio.DBusCallFlags.NONE, 5000, None)

    def on_activated(conn, sname, path, iface, sig, params, _):
        if params.unpack()[1] == "next-output":
            next_output()

    bus.signal_subscribe(PORTAL[0], "org.freedesktop.portal.GlobalShortcuts", "Activated",
                         PORTAL[1], None, Gio.DBusSignalFlags.NONE, on_activated, None)
    request("fgsession", on_session)
    bus.call_sync(PORTAL[0], PORTAL[1], "org.freedesktop.portal.GlobalShortcuts", "CreateSession",
                  GLib.Variant("(a{sv})", ({"handle_token": GLib.Variant("s", "fgsession"),
                                            "session_handle_token": GLib.Variant("s", "fgsess")},)),
                  GLib.VariantType("(o)"), Gio.DBusCallFlags.NONE, 5000, None)


ALSA_NAME_RE = re.compile(r"^PipeWire ALSA \[(.+?)\]$")


def collect():
    """Дерево приложений: корень — приложение, дети — чем именно оно звучит.

    Строка depth 0 — приложение (Anki), depth 1 — источник звука внутри него
    (mpv). Один и тот же источник у разных приложений даёт разные строки: два
    mpv под Anki и под своим софтом — это два отдельных ползунка.

    Порядок строк стабильный (по алфавиту): от того, что сейчас звучит, он не
    зависит, поэтому строки не перепрыгивают.
    """
    procs = snapshot_procs()
    all_streams = pactl_json("sink-inputs")
    if LEVELS is not None:
        LEVELS.sync(all_streams)              # измерители уровня: «звучит» по сигналу, а не по флагу
    clients = pactl_json("clients")
    store, wp = load_store(), wp_remembered()

    # ── 1) что известно аудиосерверу ────────────────────────────────────────
    client_props, label_by_pid, binary_by_pid = {}, {}, {}
    for c in clients:
        p = c.get("properties") or {}
        raw = str(p.get("application.process.id") or "")
        pid = int(raw) if raw.isdigit() else 0
        binary = p.get("application.process.binary") or ""
        name = p.get("application.name") or p.get("application.id") or ""
        if not (name or binary) or name == LEVEL_CLIENT:
            continue
        if pid and (is_generic_binary(binary) or is_generic_binary(name)) and (
                own_tool(pid) or pid not in procs):
            # наш беззвучный поток (или его уже «остывший» клиент) — не приложение
            continue
        client_props[c["index"]] = p
        if pid:
            label_by_pid.setdefault(pid, client_label(name, binary, pid))
            binary_by_pid.setdefault(pid, binary)

    def label_of(pid):
        """Как называть процесс: подпись клиента, красивое имя, имя из .desktop."""
        if pid in label_by_pid:
            return label_by_pid[pid]
        comm = (procs.get(pid) or {}).get("comm", "")
        pretty = PRETTY_BINARY.get(comm.lower())
        if pretty:
            return pretty          # «mpv» так и остаётся «mpv», а не «mpv Media Player»
        desk = desktop_lookup(comm)
        if desk:
            return desk["name"]
        return comm

    def real_chain(pid):
        """Предки процесса, через которые дерево строим (верхние/сессии отброшены)."""
        out, cur = [], pid
        for _ in range(32):
            ppid = (procs.get(cur) or {}).get("ppid", 0)
            if ppid <= 1:
                break
            cur = ppid
            if not is_ignored((procs.get(cur) or {}).get("comm", "")):
                out.append(cur)
        return out

    # ── 2) какие процессы вообще показываем ─────────────────────────────────
    # С клиентом в аудиосервере — понятно. Плюс все, кто умеет издавать звук:
    # mpv и подобные висят в трее молча, клиента у них в этот момент нет.
    catalog = media_catalog()
    interesting = set(label_by_pid)
    for pid, info in procs.items():
        comm = info["comm"].lower()
        if is_ignored(comm):
            continue      # обёртки и плееры-утилиты (pw-cat и т.п.) строками не делаем
        hit = comm in catalog
        if not hit:
            m = GENERIC_VERSION_RE.match(comm)
            hit = bool(m and m.group(1) in catalog)
        if hit:
            interesting.add(pid)

    # ── 3) почему строка стоит там, где стоит ───────────────────────────────
    # Верхний «настоящий» предок — корень приложения, сам процесс — источник
    # звука внутри него. Если подписи совпали (Brave-рендерер и сам Brave), это
    # одно и то же приложение — вкладывать нечего.
    units = {}
    for pid in interesting:
        units[pid] = label_of(pid)
    # Корень приложения заводим строкой, а промежуточных предков — нет: иначе
    # обёртки вроде claude-desktop → disclaimer → claude превращались в ложную
    # ветку «Claude / disclaimer» (ключевые процессы и так уже в units).
    for pid in list(units):
        chain = real_chain(pid)
        if chain:
            units.setdefault(chain[-1], label_of(chain[-1]))

    for pid, label in units.items():
        chain = real_chain(pid)
        root = chain[-1] if chain else pid
        if label_of(root) == label:
            root = pid
        if root == pid:
            units[pid] = {"label": label, "root": pid, "parent": "", "key": label}
        else:
            root_label = label_of(root)
            units[pid] = {"label": label, "root": root, "parent": root_label,
                          "key": "%s/%s" % (root_label, label)}

    groups = {}
    for pid, u in units.items():
        g = groups.setdefault(u["key"], {
            "key": u["key"], "label": u["label"], "parent": u["parent"],
            "depth": 1 if u["parent"] else 0,
            "pids": set(), "names": set(), "binaries": set(),
            "icons": [], "clients": set(), "streams": [],
            "ident_client": {}, "ident_stream": {},
        })
        g["pids"].add(pid)
        binary = binary_by_pid.get(pid) or (procs.get(pid) or {}).get("comm") or ""
        if binary:
            g["binaries"].add(binary)

    def ident_add(bucket, props):
        for key in IDENT_KEYS:
            val = props.get(key)
            if not val or ALSA_NAME_RE.match(str(val)):
                continue          # «PipeWire ALSA [...]» — имя потока, не приложения
            bucket.setdefault(key, set()).add(str(val))

    for index, props in client_props.items():
        raw = str(props.get("application.process.id") or "")
        pid = int(raw) if raw.isdigit() else 0
        binary = props.get("application.process.binary") or ""
        name = props.get("application.name") or props.get("application.id") or ""
        u = units.get(pid)
        if u is None:
            # клиент без процесса: заводим строку по его подписи
            if not (name or binary):
                continue
            label = client_label(name, binary, pid)
            u = {"label": label, "parent": "", "key": label}
            units[pid or ("client%d" % index)] = u
            groups.setdefault(label, {
                "key": label, "label": label, "parent": "", "depth": 0,
                "pids": set(), "names": set(), "binaries": set(),
                "icons": [], "clients": set(), "streams": [],
                "ident_client": {}, "ident_stream": {},
            })
        g = groups.get(u["key"])
        if g is None:
            continue
        g["clients"].add(index)
        ident_add(g["ident_client"], props)
        if props.get("application.icon_name"):
            g["icons"].append(props["application.icon_name"])
        if binary:
            g["binaries"].add(binary)
        for key in IDENT_KEYS:
            if props.get(key):
                g["names"].add(str(props[key]))

    # ── 4) раскладываем потоки по строкам ───────────────────────────────────
    name_count, key_by_name, key_by_binary, key_by_client = {}, {}, {}, {}
    for key, g in groups.items():
        for n in g["names"]:
            name_count[n] = name_count.get(n, 0) + 1
            key_by_name.setdefault(n, []).append(key)
        for b in g["binaries"]:
            key_by_binary.setdefault(str(b).lower(), []).append(key)
        for c in g["clients"]:
            key_by_client[c] = key

    def unique_name(value):
        hits = key_by_name.get(value) or []
        return hits[0] if len(hits) == 1 else None

    def unique_binary(value):
        hits = key_by_binary.get(str(value).lower()) or []
        return hits[0] if len(hits) == 1 else None

    # Полный дамп PipeWire нужен только для «безымянных» потоков, поэтому
    # спрашиваем его лениво — во время обычной работы он не запрашивается.
    dump, dump_tried = {}, False

    def unit_for(pid):
        """Строка для процесса: он сам, а если его нет в списке — его приложение."""
        cur = pid
        for _ in range(32):
            u = units.get(cur)
            if u is not None:
                return u["key"]
            if cur <= 1:
                break
            cur = (procs.get(cur) or {}).get("ppid", 0)
        return None

    for si in all_streams:
        props = si.get("properties") or {}
        if str(props.get(PHANTOM_MARK)).lower() in ("true", "1"):
            continue                      # наш собственный беззвучный поток
        cprops = client_props.get(si.get("client")) or {}
        raw = str(props.get("application.process.id") or cprops.get("application.process.id") or "")
        pid = int(raw) if raw.isdigit() else 0

        # 1) поток держит известный процесс — или его приложение (если звук
        #    играет дочерний процесс-плеер, строка всё равно про приложение)
        key = unit_for(pid) if pid else None
        # 2) узнаём приложение по подписи потока/клиента
        if key is None:
            for k in IDENT_KEYS:
                val = props.get(k) or cprops.get(k)
                if val:
                    key = unique_name(str(val))
                    if key:
                        break
        # 3) клиент аудиосервера уже привязан к строке
        if key is None:
            key = key_by_client.get(si.get("client"))
        # 4) «PipeWire ALSA [python3.14]» — поток мимо PipeWire-клиента:
        #    узнаём приложение по бинарнику (python3.14 — это Anki)
        if key is None:
            alsa = ALSA_NAME_RE.match(str(props.get("application.name") or ""))
            cand = alsa.group(1) if alsa else (props.get("application.process.binary") or "")
            if cand:
                key = unique_binary(cand)
        if key is None and not dump_tried:
            # Ни имени, ни процесса: уведомления quickshell, «Playback Stream».
            # Спрашиваем у PipeWire владельца потока (client.id → его свойства).
            dump, dump_tried = dump_streams(), True
        if key is None:
            hint = dump.get(str(si.get("index"))) or {}
            hint_pid = int(hint.get("pid") or 0)
            if hint_pid:
                pid = hint_pid
                key = unit_for(pid)
            if key is None and hint.get("name"):
                key = unique_name(str(hint["name"]))
            if key is None and hint.get("binary"):
                key = unique_binary(str(hint["binary"]))
            if key is None and hint.get("name"):
                # владелец известен, но строки для него ещё нет: заводим её.
                # Если такая подпись уже есть — не плодим вторую.
                label = str(hint["name"])
                key = next((k for k, g2 in groups.items()
                            if g2["label"] == label and not g2["parent"]), None)
                if key is None:
                    binary = hint.get("binary") or ""
                    chain = real_chain(pid)
                    parent = label_of(chain[-1]) if chain else ""
                    if parent == label:
                        parent = ""
                    key = "%s/%s" % (parent, label) if parent else label
                    groups.setdefault(key, {
                        "key": key, "label": label, "parent": parent,
                        "depth": 1 if parent else 0,
                        "pids": {pid} if pid else set(), "names": {label},
                        "binaries": {binary} if binary else set(),
                        "icons": [], "clients": set(), "streams": [],
                        "ident_client": {}, "ident_stream": {},
                    })
        if key is None:
            # совсем незнакомый поток — отдельная строка по бинарнику/имени файла
            binary = props.get("application.process.binary") or ""
            media = props.get("media.name") or ""
            if not (binary or media):
                continue
            fill = binary or os.path.basename(media)
            label = PRETTY_BINARY.get(fill.lower()) or fill
            key = next((k for k, g2 in groups.items()
                        if g2["label"] == label and not g2["parent"]), None)
            if key is None:
                key = label if label not in groups else "%s (поток)" % label
            g = groups.setdefault(key, {
                "key": key, "label": label, "parent": "", "depth": 0,
                "pids": set(), "names": set(), "binaries": set(),
                "icons": [], "clients": set(), "streams": [],
                "ident_client": {}, "ident_stream": {},
            })
            if binary:
                g["binaries"].add(binary)
            g["ident_stream"].setdefault("application.name", set()).add(label)

        g = groups.get(key)
        if g is None:
            continue
        g["streams"].append(si)
        ident_add(g["ident_stream"], props)

    # ── 4b) что играет: заголовки MPRIS-плееров по строкам ───────────────────
    mpris_for = {}
    for pl in mpris_players():
        key = unit_for(pl["pid"])
        if key is None:
            try:
                comm = Path("/proc/%d/comm" % pl["pid"]).read_text().strip()
            except OSError:
                comm = ""
            key = unique_binary(comm) if comm else None
        if key is not None:
            mpris_for.setdefault(key, []).append(pl)

    # ── 5) собираем строки ──────────────────────────────────────────────────
    rows = []
    for key, g in groups.items():
        names = sorted(g["names"])
        binaries = sorted(g["binaries"])
        streams = g["streams"]

        # Иконка: сначала та, что даёт само приложение в потоке, потом — из
        # установленного .desktop-файла (как в меню приложений), потом таблица
        # соответствий. Всё это проверяем на существование: имя темы или путь.
        desk = desktop_lookup(*(binaries + names + [g["label"]]))
        icon = g["icons"][0] if g["icons"] else ""
        if not icon and desk:
            icon = desk["icon"]
        if not icon:
            for cand in [b.lower() for b in binaries] + [n.lower() for n in names]:
                if cand in ICON_BY_BINARY:
                    icon = ICON_BY_BINARY[cand]
                    break
        icon = resolve_icon(icon)
        # имя приложения тоже берём человеческое («sotavpn» → «Sota Connect»),
        # но только у корневой строки, только если подпись — это бинарник и
        # только если он ещё не стал «красивым» (mpv так и остаётся «mpv»)
        if (desk and g["depth"] == 0 and " " not in g["label"]
                and g["label"].lower() not in PRETTY_BINARY
                and g["label"].lower() in [str(b).lower() for b in binaries]):
            g["label"] = desk["name"]

        # «паспорт» для памяти WirePlumber и беззвучных потоков. Берём только те
        # свойства, которые ставит само приложение, и только если они не общие
        # для нескольких приложений (иначе заденем соседа).
        ident = store["ident"].get(key) or {}
        if not ident:
            for bucket in (g["ident_client"], g["ident_stream"]):
                for k in IDENT_KEYS:
                    vals = [v for v in (bucket.get(k) or set()) if name_count.get(v, 0) == 1]
                    if len(vals) == 1:
                        ident[k] = vals[0]
                if ident:
                    break
        if not ident and not g["ident_client"] and not g["ident_stream"]:
            # приложение ещё ни разу не показывалось в аудиосервере: угадываем
            # «паспорт» по бинарнику и памяти WirePlumber (так находится mpv)
            for cand in [str(b) for b in binaries] + [g["label"]]:
                for k in IDENT_KEYS:
                    if "%s:%s" % (k, cand) in wp:
                        ident = {k: cand}
                        break
                if ident:
                    break
        if not ident and binaries:
            ident = {"application.name": str(binaries[0])}

        own = [n for n in names if name_count.get(n, 0) == 1]

        if streams:
            volume, mute = stream_volume(streams[0]), bool(streams[0].get("mute"))
        else:
            # покоящееся приложение: сначала память WirePlumber (её же видят
            # pavucontrol/wpctl), потом своя, потом 100 %
            pct = wp_lookup(wp, ident) if ident else None
            if pct is None:
                pct = store["volumes"].get(key)
            volume = 100 if pct is None else int(pct)
            mute = volume == 0

        # что сейчас играет: заголовок плеера (вкладка браузера, трек) либо имя
        # потока (файл mpv); подпись из них собирается в самом конце
        title = ""
        for si in streams:
            if si.get("corked"):
                continue
            nm = clean_media_name(str((si.get("properties") or {}).get("media.name") or ""),
                                  g["label"], binaries)
            if nm:
                title = nm
                break
        for pl in mpris_for.get(key) or []:
            if pl["status"] == "Playing" and pl["title"]:
                title = pl["title"]
                break

        system = (bool(binaries) and all(str(b).lower() in SYSTEM_BINARIES for b in binaries)) \
            or (bool(names) and all(n.lower() in SYSTEM_NAMES for n in names))

        rows.append({
            "key": key, "label": g["label"], "sub": "", "title": title, "icon": icon or "",
            "parent": g["parent"], "parent_key": None, "depth": g["depth"],
            "names": names, "own_names": own, "ident": ident,
            "binaries": binaries, "streams": streams, "targets": streams,
            "clients": sorted(g["clients"]), "phantoms": [ident] if ident else [],
            "children": [], "live": streams_active(streams),
            "volume": volume, "mute": mute,
            "pids": sorted(p for p in g["pids"] if isinstance(p, int)),
            "system": system,
        })

    # родитель — корневая строка, к которой относимся (и её «служебность»)
    roots = {}
    for r in rows:
        if not r["parent"]:
            roots.setdefault(r["label"], r)
    for r in rows:
        parent = roots.get(r["parent"]) if r["parent"] else None
        if parent is not None:
            r["parent_key"] = parent["key"]
            if parent["system"]:
                r["system"] = True

    for r in rows:
        r["children"] = [c for c in rows if c["parent_key"] == r["key"]]
    for r in rows:
        # Корневая строка — это всё приложение: её ползунок двигает и свой
        # поток, и вложенные источники (Anki → mpv). Вложенная строка двигает
        # только свой поток, поэтому два mpv у разных приложений независимы.
        own = r["streams"]
        kids = r["children"]
        r["targets"] = own + [s for c in kids for s in c["streams"]]
        phantoms = []
        for app in [r] + kids:
            if app["ident"] and app["ident"] not in phantoms:
                phantoms.append(app["ident"])
        r["phantoms"] = phantoms
        if own:
            r["volume"] = stream_volume(own[0])
            r["mute"] = bool(own[0].get("mute"))
        # без своего потока у строки остаётся её собственная (запомненная) громкость:
        # громкость вложенного источника (mpv у Anki) — это его число, не её
        r["live"] = streams_active(r["targets"])

    for r in rows:
        r["sub"] = state_text(r)

    rows.sort(key=lambda r: (r["system"],
                             (r["parent"] or r["label"]).lower(),
                             r["depth"], r["label"].lower()))

    # запоминаем бинарники и «паспорта»: по ним молчащие приложения снова узнаём.
    # «Родители-обёртки» без собственного звука в каталог не попадают — иначе в
    # списке навсегда заводились бы случайные промежуточные процессы.
    changed = False
    for r in rows:
        known = store.setdefault("known", {})
        sounds = bool(r["streams"] or r["clients"])
        bins = [b for b in r["binaries"] if b]
        if sounds and bins and known.get(r["key"]) != bins:
            known[r["key"]] = bins
            changed = True
        if sounds and r["ident"] and store["ident"].get(r["key"]) != r["ident"]:
            store["ident"][r["key"]] = r["ident"]
            changed = True
    if changed:
        save_store(store)
    return rows


