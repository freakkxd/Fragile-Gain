# «обёртки» перед самой программой в Exec=…: их имена ничего не значат
EXEC_WRAPPERS = {
    "env", "flatpak", "snap", "setsid", "nohup", "sh", "bash", "exec",
    "dbus-run-session", "gamemoderun", "prime-run", "mangohud", "systemd-run",
    "wine", "python3", "python", "node",
}

_DESKTOP_CACHE = {"stamp": None, "apps": {}, "checked": 0.0}


def _desktop_field(text, key):
    """Значение ключа из секции [Desktop Entry] (в файлах бывает всякое)."""
    inside = False
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("["):
            inside = s == "[Desktop Entry]"
            continue
        if not inside or "=" not in s or s.startswith("#"):
            continue
        k, _, v = s.partition("=")
        if k.strip() == key:
            return v.strip().strip('"')
    return ""


def _exec_binary(exec_line):
    """Из Exec=… берём имя программы без аргументов и без обёрток."""
    try:
        toks = shlex.split(exec_line)
    except ValueError:
        toks = exec_line.split()
    for tok in toks:
        if not tok or tok.startswith(("-", "@", "%")):
            continue
        base = os.path.basename(tok).lower()
        if base in EXEC_WRAPPERS or "=" in tok:
            continue
        return base
    return ""


def desktop_apps():
    """{ключ: {"name": …, "icon": …}} по установленным .desktop-файлам.

    Иконку и имя берём ровно те, что показывают в меню приложений, — тогда в
    микшере видно узнаваемую иконку, а не «первую букву на квадратике».
    """
    # Файлы перечитываем редко: список меняется только при установке программ,
    # а вызывается это на каждую строку и каждый поток.
    now = time.monotonic()
    if _DESKTOP_CACHE["apps"] and now - _DESKTOP_CACHE["checked"] < 5.0:
        return _DESKTOP_CACHE["apps"]
    _DESKTOP_CACHE["checked"] = now

    files = []
    for d in DESKTOP_DIRS:
        try:
            for f in d.glob("*.desktop"):
                try:
                    files.append((f, f.stat().st_mtime_ns))
                except OSError:
                    continue
        except OSError:
            continue
    files.sort(key=lambda x: str(x[0]))
    stamp = tuple((str(f), m) for f, m in files)
    if stamp == _DESKTOP_CACHE["stamp"]:
        return _DESKTOP_CACHE["apps"]

    apps = {}
    for f, _ in files:
        try:
            text = f.read_text(errors="replace")
        except OSError:
            continue
        if _desktop_field(text, "Type") not in ("", "Application"):
            continue
        if _desktop_field(text, "Hidden").lower() == "true":
            continue
        name, icon = _desktop_field(text, "Name"), _desktop_field(text, "Icon")
        if not name or not icon:
            continue
        entry = {"name": name, "icon": icon}
        for cand in (_exec_binary(_desktop_field(text, "Exec")),
                     _desktop_field(text, "StartupWMClass").lower(),
                     f.name[:-len(".desktop")].lower(),
                     name.lower()):
            if cand:
                apps.setdefault(cand, entry)
    _DESKTOP_CACHE["stamp"], _DESKTOP_CACHE["apps"] = stamp, apps
    return apps


def desktop_lookup(*candidates):
    """Приложение по имени бинарника / классу окна / названию."""
    apps = desktop_apps()
    for cand in candidates:
        c = str(cand or "").lower()
        if not c:
            continue
        hit = apps.get(c)
        if hit:
            return hit
        m = GENERIC_VERSION_RE.match(c)
        if m and apps.get(m.group(1)):
            return apps[m.group(1)]
    return ""


def resolve_icon(icon):
    """Иконка темы или файл по абсолютному пути — что реально существует."""
    if not icon:
        return ""
    if icon.startswith("/"):
        return icon if os.path.exists(icon) else ""
    return icon if theme_icon_exists(icon) else ""


def dump_streams():
    """Кто на самом деле держит поток: {index: {"name","binary","pid"}}.

    pactl для части потоков (уведомления quickshell, «Playback Stream» из
    Telegram и подобные) не показывает ни имени, ни процесса. В полном дампе
    PipeWire такой поток ссылается на объект-владельца (client.id), а у того
    уже есть application.name, application.process.id и pipewire.sec.pid —
    по ним и находим приложение.
    """
    r = run(["pw-dump"], timeout=15)
    if not r or r.returncode != 0:
        return {}
    try:
        objs = json.loads(r.stdout)
    except Exception:
        return {}

    props_by_id = {}
    for o in objs:
        props_by_id[o.get("id")] = (o.get("info") or {}).get("props") or {}

    def first(sources, *keys):
        for src in sources:
            for k in keys:
                v = src.get(k)
                if v:
                    return str(v)
        return ""

    out = {}
    for o in objs:
        own = (o.get("info") or {}).get("props") or {}
        if own.get("media.class") != "Stream/Output/Audio":
            continue
        # владелец потока: объект, на который указывает client.id (это может
        # быть и клиент, и узел-обёртка — поэтому смотрим по всем объектам)
        owner = {}
        try:
            owner = props_by_id.get(int(own.get("client.id"))) or {}
        except (TypeError, ValueError):
            owner = {}
        srcs = (own, owner)

        info = {
            "name": first(srcs, "application.name", "application.id"),
            "binary": first(srcs, "application.process.binary"),
            "pid": 0,
        }
        # Сначала настоящий pid приложения. Если его нет — берём владельца
        # соединения (pipewire.sec.pid), но только когда это не сам аудиосервер:
        # клиенты, созданные через pipewire-pulse, «принадлежат» ему, а не
        # приложению, и по ним мы бы подвязали поток не туда.
        raw = first(srcs, "application.process.id")
        if raw.isdigit():
            info["pid"] = int(raw)
        else:
            raw = first(srcs, "pipewire.sec.pid")
            if raw.isdigit():
                owner_pid = int(raw)
                comm = ""
                try:
                    comm = Path("/proc/%d/comm" % owner_pid).read_text().strip()
                except OSError:
                    comm = ""
                if comm and not is_ignored(comm) and not comm.startswith("pipewire"):
                    info["pid"] = owner_pid
        for key in (str(o.get("id")), str(own.get("object.serial"))):
            if key and key != "None":
                out.setdefault(key, info)
    return out


