_ICON_CACHE = {}


def _icon_path(icon):
    if icon.startswith("/"):
        return icon if os.path.exists(icon) else ""
    try:
        theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
        paintable = theme.lookup_icon(icon, None, 128, 1, Gtk.TextDirection.NONE, 0)
        f = paintable.get_file()
        return f.get_path() if f else ""
    except Exception:
        return ""


def normalized_icon(icon, box):
    """Иконка, обрезанная по видимому содержимому и вписанная в квадрат box×box.

    У иконок разные поля и пропорции: одни рисуют знак на весь холст, другие
    оставляют вокруг пустоту. Обрезаем прозрачные поля и вписываем в одинаковый
    квадрат — тогда все иконки выглядят одного размера и стоят ровно по центру.
    Возвращает Gdk.Texture (в двойном разрешении) либо None.
    """
    key = (icon, box)
    if key in _ICON_CACHE:
        return _ICON_CACHE[key]
    tex = None
    try:
        path = _icon_path(icon)
        if path:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_size(path, 256, 256)
            if not pb.get_has_alpha():
                pb = pb.add_alpha(False, 0, 0, 0)
            w, h, rs = pb.get_width(), pb.get_height(), pb.get_rowstride()
            px = pb.get_pixels()
            top, bottom, left, right = h, -1, w, -1
            for y in range(h):
                row = px[y * rs + 3: y * rs + w * 4: 4]
                xs = [x for x, a in enumerate(row) if a > 40]
                if xs:
                    top, bottom = min(top, y), y
                    left, right = min(left, xs[0]), max(right, xs[-1])
            if bottom >= 0:
                pb = pb.new_subpixbuf(left, top, right - left + 1, bottom - top + 1)
            side = box * 2
            cw, ch = pb.get_width(), pb.get_height()
            k = min(side / cw, side / ch)
            nw, nh = max(1, round(cw * k)), max(1, round(ch * k))
            pb = pb.scale_simple(nw, nh, GdkPixbuf.InterpType.HYPER)
            canvas = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, True, 8, side, side)
            canvas.fill(0)
            pb.copy_area(0, 0, nw, nh, canvas, (side - nw) // 2, (side - nh) // 2)
            tex = Gdk.Texture.new_for_pixbuf(canvas)
    except Exception:
        tex = None
    _ICON_CACHE[key] = tex
    return tex


class Marquee(Gtk.ScrolledWindow):
    """Одна строка текста; если не помещается — прокручивается, как на старых плеерах."""

    SPEED = 34.0      # пикселей в секунду
    PAUSE = 1.6       # пауза в начале и в конце, секунды

    def __init__(self, css_class, width):
        super().__init__()
        self.set_policy(Gtk.PolicyType.EXTERNAL, Gtk.PolicyType.NEVER)
        self.set_can_target(False)              # колесо мыши идёт дальше — в список
        self.set_propagate_natural_height(True)
        self.set_propagate_natural_width(False)
        self.set_size_request(width, -1)
        self.set_hexpand(False)
        self.label = Gtk.Label(xalign=0)
        self.label.add_css_class(css_class)
        self.set_child(self.label)
        self._t0 = None
        self._text = None
        # A tick callback makes GTK redraw the window on every frame for as long as it is
        # registered — so it runs only while the text really overflows and is on screen.
        self._tick_id = 0
        self.get_hadjustment().connect("changed", lambda *_: self._sync_ticking())
        self.connect("map", lambda *_: self._sync_ticking())
        self.connect("unmap", lambda *_: self._sync_ticking())

    def _overflows(self):
        adj = self.get_hadjustment()
        return adj.get_upper() - adj.get_page_size() > 1

    def _sync_ticking(self):
        want = self.get_mapped() and self._overflows()
        if want and not self._tick_id:
            self._t0 = None
            self._tick_id = self.add_tick_callback(self._tick)
        elif not want and self._tick_id:
            self.remove_tick_callback(self._tick_id)
            self._tick_id = 0
            self._t0 = None
            if self.get_hadjustment().get_value():
                self.get_hadjustment().set_value(0)

    def set_text(self, text):
        if text != self._text:
            self._text = text
            self.label.set_text(text)
            self._t0 = None
            self.get_hadjustment().set_value(0)
            self._sync_ticking()

    def _tick(self, widget, clock):
        adj = self.get_hadjustment()
        span = adj.get_upper() - adj.get_page_size()
        if span <= 1 or not self.get_mapped():
            self._tick_id = 0
            self._t0 = None
            if adj.get_value():
                adj.set_value(0)
            return False                    # stop: nothing to scroll
        now = clock.get_frame_time() / 1_000_000
        if self._t0 is None:
            self._t0 = now
        run = span / self.SPEED
        cycle = 2 * (self.PAUSE + run)
        t = (now - self._t0) % cycle
        if t < self.PAUSE:
            pos = 0.0
        elif t < self.PAUSE + run:
            pos = (t - self.PAUSE) * self.SPEED
        elif t < 2 * self.PAUSE + run:
            pos = span
        else:
            pos = span - (t - 2 * self.PAUSE - run) * self.SPEED
        adj.set_value(max(0.0, min(span, pos)))
        return True


class AppRow(Gtk.ListBoxRow):
    def __init__(self, window, app):
        super().__init__()
        self.window = window
        self.app = app
        self.suppress = False
        self.last_user_change = 0.0
        self.pending_volume = None
        self.shown_volume = None      # что сейчас на ползунке (для сдвига вложенных)
        self.gesture = None           # {"parent": v0, "kids": {key: v0}} — начало жеста
        self.tile_key = None
        self.acc_label = ""

        self.add_css_class("mixer-row")

        # Вложенные источники (Anki → mpv) рисуем с «веткой» дерева: ствол идёт
        # от приложения вниз, к каждому источнику — отвод. Приложение и его
        # источники склеены в одну карточку (классы g-head / g-mid / g-tail).
        child = bool(app.get("depth"))
        tile_size, texts_width = (26, 160) if child else (34, 190)
        if child:
            self.add_css_class("child")

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        for setter, val in (("set_margin_top", 8 if not child else 6),
                            ("set_margin_bottom", 8 if not child else 6),
                            ("set_margin_start", 12), ("set_margin_end", 12)):
            getattr(box, setter)(val)

        self.tree_bottom = None
        self.stub = None
        if child:
            # ствол вынесен за поля содержимого и тянется на всю высоту строки,
            # поэтому линия между строками не рвётся
            trunk = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            trunk.set_margin_start(28)
            top = Gtk.Box()
            top.add_css_class("tree-top")
            top.set_vexpand(True)
            self.tree_bottom = Gtk.Box()
            self.tree_bottom.add_css_class("tree-bottom")
            self.tree_bottom.set_vexpand(True)
            trunk.append(top)
            trunk.append(self.tree_bottom)
            trunk.set_homogeneous(True)
            self.trunk = trunk
            box.set_margin_start(0)

        # 1) плитка: иконка приложения либо первая буква названия на цветном фоне
        self.tile = Gtk.Box()
        self.tile.add_css_class("mixer-tile")
        self.tile.set_size_request(tile_size, tile_size)
        self.tile.set_valign(Gtk.Align.CENTER)
        self.tile_image = Gtk.Image()
        self.tile_image.set_pixel_size(22 if not child else 17)
        self.tile_letter = Gtk.Label()
        self.tile_letter.add_css_class("mixer-tile-letter")
        self.tile_letter.set_visible(False)
        self.tile.set_hexpand(False)      # ширину плитки задаёт только размер
        self.tile.set_halign(Gtk.Align.START)
        for w in (self.tile_image, self.tile_letter):
            w.set_hexpand(True)
            w.set_halign(Gtk.Align.CENTER)
            w.set_valign(Gtk.Align.CENTER)
        self.tile.append(self.tile_image)
        self.tile.append(self.tile_letter)
        box.append(self.tile)

        # 2) название + подпись — фиксированная колонка (как label/sub в rank-bars)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        texts.set_size_request(texts_width, -1)
        texts.set_valign(Gtk.Align.CENTER)
        self.label = Gtk.Label(xalign=0)
        self.label.add_css_class("mixer-name")
        self.label.set_ellipsize(3)
        self.dot = Gtk.Box()
        self.dot.add_css_class("live-dot")
        self.dot.set_valign(Gtk.Align.CENTER)
        self.dot.set_visible(False)
        name_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        name_row.append(self.label)
        name_row.append(self.dot)
        # длинное название (вкладка браузера) не раздвигает колонку, а бежит строкой
