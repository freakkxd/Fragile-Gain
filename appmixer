GENERIC_MEDIA_NAMES = {
    "", "playback", "audio stream", "playstream", "playback stream", "audio",
    "stream", "output", "sound", "pipewire", "(null)", "chromium input", "brave input",
}


def mpris_players():
    """Плееры на шине сессии: заголовок, статус и pid процесса-владельца."""
    out = []
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        names = bus.call_sync(
            "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
            "ListNames", None, GLib.VariantType("(as)"), Gio.DBusCallFlags.NONE,
            300, None).unpack()[0]
    except Exception:
        return out
    for name in names:
        if not name.startswith("org.mpris.MediaPlayer2.") or name.endswith(".playerctld"):
            continue
        try:
            props = bus.call_sync(
                name, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties",
                "GetAll", GLib.Variant("(s)", ("org.mpris.MediaPlayer2.Player",)),
                GLib.VariantType("(a{sv})"), Gio.DBusCallFlags.NONE, 300, None).unpack()[0]
            pid = bus.call_sync(
                "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                "GetConnectionUnixProcessID", GLib.Variant("(s)", (name,)),
                GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 300, None).unpack()[0]
        except Exception:
            continue
        meta = props.get("Metadata") or {}
        title = str(meta.get("xesam:title") or "").strip()
        artist = meta.get("xesam:artist") or []
        if isinstance(artist, (list, tuple)):
            artist = ", ".join(str(a) for a in artist if a)
        out.append({"bus": name, "pid": int(pid), "status": str(props.get("PlaybackStatus") or ""),
                    "title": title, "artist": str(artist or "").strip()})
    return out


def clean_media_name(name, label, binaries):
    """Имя потока без служебных слов; пусто, если это не название звука."""
    n = (name or "").strip()
    if n.lower().endswith(" - mpv"):
        n = n[:-6].strip()
    low = n.lower()
    if low in GENERIC_MEDIA_NAMES or low.startswith("alsa plugin"):
        return ""
    if low == (label or "").lower() or low in [str(b).lower() for b in binaries]:
        return ""
    return n


