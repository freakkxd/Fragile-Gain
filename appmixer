    Процесс беззвучного потока запускает сам микшер, поэтому в его командной
    строке есть «appmixer» — по ней и отличаем его от чужого pw-cat.
    """
    try:
        return b"appmixer" in Path("/proc/%s/cmdline" % pid).read_bytes()
    except OSError:
