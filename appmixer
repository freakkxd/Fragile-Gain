# ─────────────────────────────────────────────────────────────────────────────
#  Память о громкости: наша + wireplumber'овская
# ─────────────────────────────────────────────────────────────────────────────

def wp_unescape(s):
    """WirePlumber кодирует ключи: пробел -> \\s, '[' -> \\o, ']' -> \\c."""
    out, i = [], 0
    while i < len(s):
        if s[i] == "\\" and i + 1 < len(s):
            nxt = s[i + 1]
            out.append({"s": " ", "o": "[", "c": "]", "n": "\n", "t": "\t"}.get(nxt, nxt))
            i += 2
        else:
            out.append(s[i])
            i += 1
    return "".join(out)


_wp_cache = {"mtime": None, "table": {}}

# «Паспорт» приложения в аудиосервере: по этим свойствам WirePlumber узнаёт
# приложение и запоминает его громкость. У обычных программ это application.name,
# а, например, mpv ставит только application.id.
IDENT_KEYS = ("application.name", "application.id")


def wp_percent(data):
    """Процент из записи WirePlumber.

    В файле лежат два значения: «мягкая» громкость (volume) и канальная
    (channelVolumes) в линейной амплитуде. Микшеры (pactl, pavucontrol) и мы
    показываем канальную в кубической шкале, мягкую не учитываем — иначе одно и
    то же приложение в разных программах выглядело бы по-разному.
    """
    try:
        hard = max(data.get("channelVolumes") or [1.0])
        return int(round(hard ** (1.0 / 3.0) * 100))
    except Exception:
        return None


def wp_remembered():
    """{"application.name:mpv": процент} из состояния WirePlumber (кэш по mtime)."""
    try:
        mtime = WP_PROPS.stat().st_mtime
    except OSError:
        return {}
    if _wp_cache["mtime"] == mtime:
        return _wp_cache["table"]

    table, head = {}, "Output/Audio:"
    try:
        text = WP_PROPS.read_text(errors="replace")
    except OSError:
        return {}
    for line in text.splitlines():
        if not line.startswith(head):
            continue
        key, _, val = line.partition("=")
        key = key[len(head):]
        if not key.startswith(IDENT_KEYS):
            continue
        try:
            pct = wp_percent(json.loads(val))
        except Exception:
            continue
        if pct is not None:
            table[wp_unescape(key)] = pct
    _wp_cache["mtime"], _wp_cache["table"] = mtime, table
    return table


def wp_lookup(table, ident):
    """Громкость из памяти WirePlumber по «паспорту» приложения."""
    for key, val in ident.items():
        pct = table.get("%s:%s" % (key, val))
        if pct is not None:
            return pct
    return None


