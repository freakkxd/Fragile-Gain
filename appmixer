def client_label(name, binary, pid):
    """Человекочитаемая подпись приложения (используется и как ключ группировки).

    Для обёрток (pw-cat, python, electron и т.п.) подпись берём из
    application.name, иначе — из имени исполняемого файла.
    """
    hint = proc_hint(pid, binary)
    if hint:
        return hint[:1].upper() + hint[1:]
    b = binary.lower()
    if b and not is_generic_binary(b):
        return PRETTY_BINARY.get(b) or binary
    return PRETTY_BINARY.get(name.lower()) or name


_PROCS = {}
_PROCS_AT = 0.0


def snapshot_procs():
    """Срез процессов: {pid: {"comm": имя, "ppid": родитель}}.

    Для скриптов с шебангом comm — имя самого скрипта: у Anki это «anki», хотя
    реально запущен python3.14. Именно это и нужно, чтобы строить дерево.
    """
    # Read once per process: the window refreshes every second and re-reading all ~500
    # /proc/*/stat files each time was most of its CPU. New processes are read at once,
    # gone ones dropped; everything is re-read every 10 s (a parent can change on reparenting).
    global _PROCS_AT
    try:
        entries = os.listdir("/proc")
    except OSError:
        return {}
    now = time.monotonic()
    if now - _PROCS_AT > 10:
        _PROCS.clear()
        _PROCS_AT = now
    alive = set()
    for entry in entries:
        if not entry.isdigit():
            continue
        pid = int(entry)
        alive.add(pid)
        if pid in _PROCS:
            continue
        try:
            stat = Path("/proc/%s/stat" % entry).read_text()
        except OSError:
            continue
        cut = stat.rindex(")")
        try:
            _PROCS[pid] = {
                "comm": stat[stat.index("(") + 1:cut],
                "ppid": int(stat[cut + 2:].split()[1]),
            }
        except (ValueError, IndexError):
            continue
    for pid in [p for p in _PROCS if p not in alive]:
        del _PROCS[pid]
    return {pid: dict(info) for pid, info in _PROCS.items()}


def is_ignored(comm):
    """Через такие процессы дерево не строим: оболочки, терминалы, сессия.

    Благодаря этому mpv, запущенный из терминала, остаётся сам себе корнем, а
    mpv, которого запустил Anki (anki → mpv), вкладывается в Anki.
    """
    c = (comm or "").lower()
    if not c:
        return True
    if c in IGNORE_COMM:
        return True
    m = GENERIC_VERSION_RE.match(c)
    return bool(m and m.group(1) in IGNORE_COMM)


