        """Запись сочетания: ловим первую «настоящую» клавишу вместе с модификаторами."""
        if not self.recording:
            return False
        if keyval in (Gdk.KEY_Control_L, Gdk.KEY_Control_R, Gdk.KEY_Shift_L, Gdk.KEY_Shift_R,
                      Gdk.KEY_Alt_L, Gdk.KEY_Alt_R, Gdk.KEY_Super_L, Gdk.KEY_Super_R,
                      Gdk.KEY_ISO_Level3_Shift, Gdk.KEY_Meta_L, Gdk.KEY_Meta_R):
            return True                          # просто модификатор — ждём остальное
        self.recording = False
        if keyval != Gdk.KEY_Escape:
            mods = state & Gtk.accelerator_get_default_mod_mask()
            cfg = load_outputs_cfg()
            cfg["hotkey"] = Gtk.accelerator_name(keyval, mods)
            save_outputs_cfg(cfg)
        self.rebuild_outputs()
        return True

    def _style(self, vol, muted):
        for widget in (self, self.scale):
            for name, on in (("muted", muted), ("boost", vol > 100 and not muted)):
                if on:
                    widget.add_css_class(name)
                else:
                    widget.remove_css_class(name)
        self.mute_btn.set_icon_name(MUTE_ICON if muted else LIVE_ICON)
        self.mute_btn.set_tooltip_text(tr("Включить звук") if muted else tr("Заглушить всю систему"))
        try:
            self.mute_btn.update_property([Gtk.AccessibleProperty.LABEL],
                                          [tr("Включить звук") if muted else tr("Заглушить всю систему")])
        except Exception:
            pass

    def update(self, info):
        if not info:
            self.set_visible(False)
            return
        self.set_visible(True)
        self.title.set_text(tr("Общая громкость"))
        self.out_label.set_text(info["label"])
        self.out_button.set_tooltip_text(tr("Устройство вывода"))
        busy = (time.monotonic() - self.last_user_change) < 2.0
        self.suppress = True
        try:
            if not busy:
                adj = self.scale.get_adjustment()
                if info["volume"] > adj.get_upper():
                    adj.set_upper(info["volume"] + 25)
                self.scale.set_value(info["volume"])
            vol = int(self.scale.get_value())
            self.pct.set_text("%d%%" % vol)
            muted = bool(info["mute"]) or vol == 0
            self.mute_btn.set_active(muted)
            self._style(vol, muted)
        finally:
            self.suppress = False

    def _schedule(self, vol):
        """Сразу в аудиосервер; пока команда идёт — копим только последнее значение."""
        self.last_user_change = time.monotonic()
        self.pending = vol
        if getattr(self, "_busy", False):
            return
        self._busy = True
        sent = vol
        try:
            proc = Gio.Subprocess.new(["pactl", "set-sink-volume", "@DEFAULT_SINK@", "%d%%" % vol],
                                      Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
        except Exception:
            self._busy = False
            return

        def done(p, res):
            try:
                p.wait_finish(res)
            except Exception:
                pass
            self._busy = False
            if self.pending != sent:
                self._schedule(self.pending)
        proc.wait_async(None, done)

    def on_wheel(self, controller, dx, dy):
        if self.suppress or not dy:
            return False
        state = controller.get_current_event_state()
        step = 10 if state & Gdk.ModifierType.CONTROL_MASK else VOLUME_STEP
        tick = int(dy) if abs(dy) >= 1 else (1 if dy > 0 else -1)
        vol = max(0, int(self.scale.get_value()) - tick * step)
        adj = self.scale.get_adjustment()
        if vol > adj.get_upper():
            adj.set_upper(vol + 25)
        self.last_user_change = time.monotonic()
        self.scale.set_value(vol)
        return True

    def on_scale(self, scale):
        if self.suppress:
            return
        vol = int(scale.get_value())
        self.pct.set_text("%d%%" % vol)
        self._style(vol, vol == 0)
        self._schedule(vol)

    def on_mute(self, btn):
        if self.suppress:
            return
        self.last_user_change = time.monotonic()
        master_set_mute(btn.get_active())


